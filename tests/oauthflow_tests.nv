// oauthflow_tests.nv — the performing half, asserted without a server.
//
// NOTHING HERE OPENS A SOCKET.  What is asserted is what a flow does
// before it connects: refuse an endpoint that is not `https`, refuse a
// callback that is not this flow's, refuse a client-credentials client
// with no credentials, refuse a verifier outside RFC 7636 § 4.1's
// grammar, and read an introspection document.  Those refusals are the
// ones a deployment meets on its first run.  Everything that does reach
// a server is in oauthnet_tests.nv, against a local authorization
// server (tests/network.sh).

use std.test
use std.bytes
use std.str
use civil
use oautherr
use oauthflow
use oauthmsg
use oauthtoken

// RFC 7636 Appendix B's verifier.
fn a_verifier() -> Str
    "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"

fn a_moment() -> civil.CivilDateTime
    match civil.date(2026, 9, 11)
        Ok(d)  => civil.datetime(d, civil.midnight())
        Err(_) => civil.datetime(civil.date_from_epoch_day(0), civil.midnight())

fn a_public_client() -> oauthmsg.OauthClient
    oauthmsg.client("cli", "http://127.0.0.1:8765/cb")

fn a_confidential_client() -> oauthmsg.OauthClient
    oauthmsg.with_secret(oauthmsg.client("svc", ""), "s3cret", oauthmsg.OauthAuthBasic)

fn a_pending() -> oauthmsg.OauthPending
    oauthmsg.pending(a_public_client(), "state-value", "", a_verifier())

fn a_device_grant() -> oauthmsg.OauthDeviceGrant
    match oauthmsg.read_device_response(
            "{\"device_code\":\"d\",\"user_code\":\"WDJB-MJHT\","
        + "\"verification_uri\":\"https://example.com/device\",\"expires_in\":1800}")
        Ok(g)  => g
        Err(_) => OauthDeviceGrant { device_code: "", user_code: "",
                                     verification_uri: "",
                                     verification_uri_complete: "",
                                     expires_in: 0, interval: 5 }

@test
fn test_begin_from_is_the_testable_twin_and_costs_nothing() [io]
    test.case("the same value, with the randomness supplied")
    match oauthflow.begin_from(a_public_client(), "state-value", "", a_verifier())
        Err(_) => test.fail("refused")
        Ok(p)  =>
            test.assert_eq_str(p.state, "state-value")
            test.assert_eq_str(p.verifier, a_verifier())

    test.case("a verifier outside the grammar is refused HERE rather than at the exchange")
    match oauthflow.begin_from(a_public_client(), "st", "", "tooshort")
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "code_verifier"))

    test.case("a flow with no state checks nothing and is refused")
    match oauthflow.begin_from(a_public_client(), "", "", a_verifier())
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "state"))

@test
fn test_a_flow_started_from_draws_refuses_a_draw_that_never_came() [io]
    let c = a_public_client()
    let some = Some(bytes.from_byte_list([251, 255, 191]))
    test.case("all three arrived")
    match oauthflow.begin_from_draws(c, some, some, Some(bytes.from_byte_list(list.zeros(32))))
        Ok(p)  =>
            test.assert_eq_str(p.state, "-_-_")
            test.assert_eq_str(p.nonce, "-_-_")
            test.assert_eq(str.len(p.verifier), 43)
        Err(f) => test.fail("refused: ${f.message()}")
    test.case("no nonce wanted: an empty draw")
    match oauthflow.begin_from_draws(c, some, Some(bytes.zeros(0)), Some(bytes.from_byte_list(list.zeros(32))))
        Ok(p)  => test.assert_eq_str(p.nonce, "")
        Err(f) => test.fail("refused: ${f.message()}")
    test.case("each missing draw is no entropy, whichever one it is")
    let v = Some(bytes.from_byte_list(list.zeros(32)))
    for r in [oauthflow.begin_from_draws(c, None, some, v), oauthflow.begin_from_draws(c, some, None, v),
              oauthflow.begin_from_draws(c, some, some, None)]
        match r
            Ok(_)  => test.fail("accepted")
            Err(f) => test.assert(str.contains(f.message(), "generator"))
    test.case("a short verifier draw is the verifier grammar's refusal")
    match oauthflow.begin_from_draws(c, some, some, some)
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "code_verifier"))

@test
fn test_an_endpoint_that_is_not_https_is_refused_before_the_socket() [io, net, time, async]
    test.case("the one exchange")
    match oauthflow.post_form("http://id.example/token", a_public_client(), [])
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(oautherr.is_configuration_fault(f))

    test.case("and the authorization URL, which is the other half")
    match oauthflow.authorize_url("http://id.example/authorize", a_public_client(), a_pending())
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(oautherr.is_configuration_fault(f))

@test
fn test_the_authorization_url_is_the_same_one_oauthmsg_builds() [io]
    match oauthflow.authorize_url("https://id.example/authorize", a_public_client(), a_pending())
        Err(_) => test.fail("refused")
        Ok(u)  => test.assert(str.contains(u, "state=state-value"))

@test
fn test_exchange_code_will_not_run_without_the_state_the_flow_sent() [io, net, time, async]
    // The signature is the test: there is no spelling of this call
    // that omits the `OauthPending`.  What is asserted is what happens
    // when the callback does not belong to it.
    test.case("a callback from another flow never reaches the network")
    let cb = oauthmsg.read_callback("code=attacker-code&state=some-other-state")
    match oauthflow.exchange_code("https://id.example/token", a_public_client(),
                                  a_pending(), cb, a_moment())
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert_eq_str(oautherr.fault_code(f), "")

    test.case("and a refused callback comes back as the server's own fault")
    let denied = oauthmsg.read_callback("error=access_denied&state=state-value")
    match oauthflow.exchange_code("https://id.example/token", a_public_client(),
                                  a_pending(), denied, a_moment())
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert_eq_str(oautherr.fault_code(f), "access_denied")

@test
fn test_client_credentials_refuses_a_public_client_before_it_asks() [io, net, time, async]
    // This grant authenticates the CLIENT, and a client with no
    // credentials has nothing to authenticate with.
    match oauthflow.client_credentials("https://id.example/token", a_public_client(),
                                       ["api"], a_moment())
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(oautherr.is_configuration_fault(f))

@test
fn test_a_refresh_with_nothing_to_refresh_with_is_refused_locally() [io, net, time, async]
    match oauthflow.refresh("https://id.example/token", a_public_client(), oauthtoken.token("a"), [], a_moment())
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert_eq_str(oautherr.fault_code(f), "invalid_grant")

@test
fn test_ensure_fresh_leaves_a_token_with_no_expiry_alone() [io, net, time, async]
    // A token with no expiry is not refreshed on every call.
    let t = oauthtoken.with_refresh(oauthtoken.token("a"), "r")
    match oauthflow.ensure_fresh("https://id.example/token", a_public_client(), t, a_moment(), 30)
        Ok(t2) => test.assert_eq_str(t2.access_token, "a")
        Err(f) => test.fail("refused: ${f.message()}")

@test
fn test_introspection_fails_closed() [io]
    // A document a resource server cannot read is not an authorization.
    test.assert(not oauthflow.is_active("{}"))
    test.assert(not oauthflow.is_active("<html>502</html>"))
    test.assert(not oauthflow.is_active("{\"active\":\"yes\"}"))
    test.assert(oauthflow.is_active("{\"active\":true}"))

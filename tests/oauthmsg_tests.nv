// oauthmsg_tests.nv — the message arithmetic, against the RFCs' own
// example values.
//
// THE VECTORS ARE THE SPECIFICATIONS' OWN.  RFC 7636 Appendix B
// publishes a verifier and the challenge it hashes to, which is the
// one PKCE vector everybody implements against; RFC 6749 § 2.3.1,
// § 4.1.1, § 4.1.3 and § 5.1 publish their example requests and
// responses; RFC 8628 § 3.2 publishes a device authorization response
// complete with the user code people actually see.  Nothing below is
// a value this package invented.

use std.test
use std.bytes
use std.list
use std.str
use arith
use civil
use span
use oauthtoken
use formurl
use oautherr
use oauthmsg

// RFC 7636 Appendix B's verifier.  Forty-three characters of
// `unreserved`, which is the minimum § 4.1 allows.
fn rfc7636_verifier() -> Str
    "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"

// Its `S256` challenge, from the same appendix.
fn rfc7636_challenge() -> Str
    "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"

// RFC 6749 § 5.1's example token response, verbatim.
fn rfc6749_token_response() -> Str
    "{\"access_token\":\"2YotnFZFEjr1zCsicMWpAA\","
        + "\"token_type\":\"example\",\"expires_in\":3600,"
        + "\"refresh_token\":\"tGzv3JOkF0XG5Qx2TlKWIA\","
        + "\"example_parameter\":\"example_value\"}"

// RFC 8628 § 3.2's example device authorization response, verbatim.
fn rfc8628_device_response() -> Str
    "{\"device_code\":\"GmRhmhcxhwAzkoEqiMEg_DnyEysNkuNhszIySk9eS\","
        + "\"user_code\":\"WDJB-MJHT\","
        + "\"verification_uri\":\"https://example.com/device\","
        + "\"verification_uri_complete\":\"https://example.com/device?user_code=WDJB-MJHT\","
        + "\"expires_in\":1800,\"interval\":5}"

// A fixed civil date-time, so nothing here reads a clock.
fn a_moment() -> civil.CivilDateTime
    match civil.date(2026, 9, 11)
        Ok(d)  => civil.datetime(d, civil.midnight())
        Err(_) => civil.datetime(civil.date_from_epoch_day(0), civil.midnight())

@test
fn test_a_client_is_public_until_it_is_given_a_secret() [io]
    test.case("the plain constructor makes a public client")
    let c = oauthmsg.client("s6BhdRkqt3", "https://client.example.com/cb")
    test.assert(not oauthmsg.is_confidential(c))

    test.case("and a secret makes it confidential")
    let c2 = oauthmsg.with_secret(c, "gX1fBat3bV", oauthmsg.OauthAuthBasic)
    test.assert(oauthmsg.is_confidential(c2))

    test.case("scopes and the PKCE method are the other two knobs")
    let c3 = oauthmsg.with_pkce(oauthmsg.with_scopes(c, ["openid", "email"]),
                                oauthmsg.OauthPkceS256)
    test.assert(list.len(c3.scopes) == 2)
    test.assert_eq_str(oauthmsg.pkce_method_name(c3.pkce), "S256")

@test
fn test_plain_is_the_weak_pkce_method_and_says_so() [io]
    test.case("S256 is not plain_client")
    test.assert(not oauthmsg.pkce_is_weak(oauthmsg.OauthPkceS256))

    test.case("plain is, because the verifier travels in the authorization request")
    test.assert(oauthmsg.pkce_is_weak(oauthmsg.OauthPkcePlain))

    test.case("and both have a wire name")
    test.assert_eq_str(oauthmsg.pkce_method_name(oauthmsg.OauthPkcePlain), "plain")

@test
fn test_rfc_7636_appendix_b_is_the_pkce_vector() [io]
    test.case("the appendix's verifier is inside § 4.1's grammar")
    test.assert(oauthmsg.verifier_ok(rfc7636_verifier()))

    test.case("and hashes to the appendix's challenge")
    match oauthmsg.pkce_challenge(rfc7636_verifier(), oauthmsg.OauthPkceS256)
        Err(_) => test.assert(false)
        Ok(ch) => test.assert_eq_str(ch, rfc7636_challenge())

    test.case("plain is the verifier unchanged")
    match oauthmsg.pkce_challenge(rfc7636_verifier(), oauthmsg.OauthPkcePlain)
        Err(_) => test.assert(false)
        Ok(ch) => test.assert_eq_str(ch, rfc7636_verifier())

    test.case("and the pair verifies")
    test.assert(oauthmsg.pkce_matches(rfc7636_verifier(), rfc7636_challenge(),
                                      oauthmsg.OauthPkceS256))

@test
fn test_a_verifier_outside_the_grammar_is_refused_rather_than_hashed() [io]
    test.case("shorter than 43 characters")
    test.assert(not oauthmsg.verifier_ok("tooshort"))

    test.case("longer than 128")
    var long = ""
    for _ in 0..130
        long = long + "a"
    test.assert(not oauthmsg.verifier_ok(long))

    test.case("a character outside unreserved — standard base64's `+` is the trap")
    test.assert(not oauthmsg.verifier_ok("dBjftJeZ4CVP+mB92K27uhbUJU1p1r_wW1gFWFOEjXk"))

    test.case("and a challenge is refused rather than computed from one")
    match oauthmsg.pkce_challenge("tooshort", oauthmsg.OauthPkceS256)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_the_verifier_is_thirty_two_bytes_base64url() [io]
    test.case("§ 7.1 asks for 256 bits")
    test.assert(oauthmsg.verifier_bytes() == 32)

    test.case("and a state carries the same")
    test.assert(oauthmsg.state_bytes() == 32)

    test.case("32 bytes base64url-encode to 43 characters, § 4.1's minimum")
    test.assert(str.len(oauthmsg.verifier_of(bytes.from_byte_list([0]))) >= 1)

@test
fn test_scope_is_space_delimited_and_an_empty_grant_means_everything() [io]
    test.case("joining")
    test.assert_eq_str(oauthmsg.scope_join(["openid", "email"]), "openid email")

    test.case("splitting drops the empties a doubled space leaves")
    test.assert(list.len(oauthmsg.scope_split("openid  email ")) == 2)

    test.case("a granted string covers what it lists")
    test.assert(oauthmsg.scope_covers("openid email", ["email"]))
    test.assert(not oauthmsg.scope_covers("openid", ["email"]))

    test.case("and an EMPTY granted string means `what you asked for` — § 5.1")
    test.assert(oauthmsg.scope_covers("", ["email", "openid"]))

    test.case("a control character is not a scope-token")
    test.assert(oauthmsg.scope_ok("openid email"))
    test.assert(not oauthmsg.scope_ok("open\nid"))

@test
fn test_the_authorization_url_is_rfc_6749_4_1_1() [io]
    let c = oauthmsg.client("s6BhdRkqt3", "https://client.example.com/cb")
    let p = oauthmsg.pending(c, "xyz", "", rfc7636_verifier())

    test.case("the parameters § 4.1.1 lists, plus § 4.3's two")
    let ps = oauthmsg.authorize_params(c, p, [])
    test.assert(list.len(ps) >= 5)

    test.case("and a URL built from them")
    match oauthmsg.authorize_url("https://server.example.com/authorize", c, p, [])
        Err(_) => test.assert(false)
        Ok(u)  =>
            test.assert(str.contains(u, "response_type=code"))
            test.assert(str.contains(u, "state=xyz"))
            test.assert(str.contains(u, "code_challenge_method=S256"))

@test
fn test_an_authorization_endpoint_that_is_not_https_is_refused() [io]
    let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
    let p = oauthmsg.pending(c, "st", "", rfc7636_verifier())

    test.case("plain http to a public host")
    match oauthmsg.authorize_url("http://id.example/authorize", c, p, [])
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("https is fine")
    test.assert(oauthmsg.endpoint_ok("https://id.example/authorize"))

    test.case("and RFC 8252 § 8.3's loopback exception is the one http that passes")
    test.assert(oauthmsg.endpoint_ok("http://127.0.0.1:8765/cb"))
    test.assert(oauthmsg.endpoint_ok("http://[::1]:8765/cb"))
    test.assert(not oauthmsg.endpoint_ok("http://id.example/cb"))

@test
fn test_an_extra_parameter_may_not_shadow_one_the_request_already_sends() [io]
    // A second `state` is how a client is talked into checking the
    // wrong one, so the refusal is a security property rather than
    // tidiness.
    let c = oauthmsg.client("cli", "https://app.example/cb")
    let p = oauthmsg.pending(c, "st", "", rfc7636_verifier())

    test.case("a duplicate `state` is refused")
    match oauthmsg.authorize_url("https://id.example/authorize", c, p,
                                 [("state", "attacker")])
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a parameter of the caller's own is fine")
    match oauthmsg.authorize_url("https://id.example/authorize", c, p,
                                 [("prompt", "consent")])
        Err(_) => test.assert(false)
        Ok(u)  => test.assert(str.contains(u, "prompt=consent"))

@test
fn test_a_callback_has_three_answers_and_not_a_maybe() [io]
    test.case("a code")
    match oauthmsg.read_callback("code=SplxlOBeZQQYbYS6WxSbIA&state=xyz")
        OauthCallbackCode(code, st, _)   => test.assert_eq_str(st, "xyz")
        OauthCallbackRefused(_, _, _, _) => test.assert(false)
        OauthCallbackUnreadable(_)       => test.assert(false)

    test.case("a refusal — the end user pressed Cancel, which is not a failure")
    match oauthmsg.read_callback("error=access_denied&state=xyz")
        OauthCallbackCode(_, _, _)       => test.assert(false)
        OauthCallbackRefused(e, _, _, _) => test.assert_eq_str(e, "access_denied")
        OauthCallbackUnreadable(_)       => test.assert(false)

    test.case("and something that is neither")
    match oauthmsg.read_callback("nonsense=1")
        OauthCallbackCode(_, _, _)       => test.assert(false)
        OauthCallbackRefused(_, _, _, _) => test.assert(false)
        OauthCallbackUnreadable(_)       => test.assert(true)

@test
fn test_a_repeated_parameter_in_the_callback_is_seen_rather_than_answered_first() [io]
    // The standard library's `http.server.query_get` answers the first
    // match and drops the rest.  "The first `state`" is exactly the
    // value an attacker would like a client to check, so a callback
    // carrying two is unreadable here rather than half-read.
    test.case("two `state` parameters")
    match oauthmsg.read_callback("code=a&state=mine&state=theirs")
        OauthCallbackCode(_, _, _)       => test.assert(false)
        OauthCallbackRefused(_, _, _, _) => test.assert(false)
        OauthCallbackUnreadable(_)       => test.assert(true)

    test.case("two `code` parameters")
    match oauthmsg.read_callback("code=a&code=b&state=s")
        OauthCallbackCode(_, _, _)       => test.assert(false)
        OauthCallbackRefused(_, _, _, _) => test.assert(false)
        OauthCallbackUnreadable(_)       => test.assert(true)

@test
fn test_the_form_post_response_mode_reads_the_same() [io]
    test.case("the parameters arrive in a body rather than a query")
    let b = formurl.parse_str("code=SplxlOBeZQQYbYS6WxSbIA&state=xyz")
    match oauthmsg.read_callback_body(b)
        OauthCallbackCode(_, st, _)      => test.assert_eq_str(st, "xyz")
        OauthCallbackRefused(_, _, _, _) => test.assert(false)
        OauthCallbackUnreadable(_)       => test.assert(false)

    test.case("and the state is readable whichever kind it is")
    test.assert_eq_str(oauthmsg.callback_state(
        oauthmsg.read_callback("error=access_denied&state=xyz")),
        "xyz")

@test
fn test_the_state_check_is_the_whole_point_of_the_pending_value() [io]
    let c = oauthmsg.client("cli", "https://app.example/cb")
    let p = oauthmsg.pending(c, "xyz", "", rfc7636_verifier())

    test.case("the flow's own callback yields the code")
    match oauthmsg.check_state(p, oauthmsg.read_callback("code=SplxlOB&state=xyz"))
        Err(_)   => test.assert(false)
        Ok(code) => test.assert_eq_str(code, "SplxlOB")

    test.case("a callback from another flow is refused — this is the login CSRF")
    match oauthmsg.check_state(p, oauthmsg.read_callback("code=attacker&state=other"))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a refusal comes back as the server's own fault")
    match oauthmsg.check_state(p, oauthmsg.read_callback("error=access_denied&state=xyz"))
        Ok(_)  => test.assert(false)
        Err(f) => test.assert_eq_str(oautherr.fault_code(f), "access_denied")

@test
fn test_rfc_9207_ties_a_callback_to_the_issuer_that_sent_it() [io]
    let c = oauthmsg.client("cli", "https://app.example/cb")
    let p = oauthmsg.with_issuer(oauthmsg.pending(c, "xyz", "", rfc7636_verifier()),
                                 "https://id.example")

    test.case("the right issuer passes")
    match oauthmsg.check_state(p, oauthmsg.read_callback(
            "code=a&state=xyz&iss=https%3A%2F%2Fid.example"))
        Err(_) => test.assert(false)
        Ok(_)  => test.assert(true)

    test.case("another authorization server's `iss` is a mix-up and is refused")
    match oauthmsg.check_state(p, oauthmsg.read_callback(
            "code=a&state=xyz&iss=https%3A%2F%2Fevil.example"))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_pending_flow_can_be_dated_and_aged() [io]
    let c = oauthmsg.client("cli", "https://app.example/cb")
    let p = oauthmsg.pending(c, "xyz", "n", rfc7636_verifier())

    test.case("undated by default, so `pending_age` says it does not know")
    test.assert_none(oauthmsg.pending_age(p, a_moment()))

    test.case("dated, it ages")
    let at = a_moment()
    test.assert_some(oauthmsg.pending_age(oauthmsg.started_at(p, at), at))

@test
fn test_a_pending_flow_and_a_token_redact_their_secrets() [io]
    let c = oauthmsg.client("cli", "https://app.example/cb")
    let p = oauthmsg.pending(c, "xyz", "n", rfc7636_verifier())

    test.case("the verifier is not in the redaction")
    test.assert(not str.contains(oauthmsg.pending_redacted(p), rfc7636_verifier()))

@test
fn test_every_token_request_body_is_the_rfcs_parameter_list() [io]
    let c = oauthmsg.with_secret(oauthmsg.client("s6BhdRkqt3", "https://client.example.com/cb"),
                                 "gX1fBat3bV", oauthmsg.OauthAuthPost)
    let p = oauthmsg.pending(c, "xyz", "", rfc7636_verifier())

    test.case("§ 4.1.3 — code, grant_type, redirect_uri, code_verifier")
    test.assert(list.len(oauthmsg.code_params(c, p, "SplxlOBeZQQYbYS6WxSbIA")) >= 4)

    test.case("§ 4.4.2 — client_credentials carries no redirect_uri")
    test.assert(list.len(oauthmsg.client_credentials_params(c, ["api"])) >= 1)

    test.case("RFC 8628 § 3.1 — a device authorization request")
    test.assert(list.len(oauthmsg.device_params(c, ["openid"])) >= 1)

    test.case("RFC 8628 § 3.4 — the poll, whose grant type is a URN")
    let dp = oauthmsg.device_token_params(c, "GmRhmhcx")
    test.assert(list.len(dp) >= 2)

    test.case("§ 6 — a refresh")
    test.assert(list.len(oauthmsg.refresh_params(c, "tGzv3JOkF0XG5Qx2TlKWIA", [])) >= 2)

    test.case("RFC 7009 § 2.1 and RFC 7662 § 2.1")
    test.assert(list.len(oauthmsg.revoke_params(c, "tok", "refresh_token")) >= 1)
    test.assert(list.len(oauthmsg.introspect_params(c, "tok", "")) >= 1)

@test
fn test_the_basic_header_urlencodes_before_it_base64s() [io]
    // RFC 6749 § 2.3.1: the id and the secret are
    // `application/x-www-form-urlencoded` FIRST.  Half the clients in
    // the world skip that, which works until a secret contains a
    // character the encoding changes.
    test.case("§ 2.3.1's own example credentials")
    let c = oauthmsg.with_secret(oauthmsg.client("s6BhdRkqt3", ""),
                                 "gX1fBat3bV", oauthmsg.OauthAuthBasic)
    match oauthmsg.auth_header(c)
        None    => test.assert(false)
        Some(h) => test.assert_eq_str(h, "Basic czZCaGRSa3F0MzpnWDFmQmF0M2JW")

    test.case("a secret with a `+` is encoded before it is base64ed")
    let c2 = oauthmsg.with_secret(oauthmsg.client("id", ""), "a+b", oauthmsg.OauthAuthBasic)
    match oauthmsg.auth_header(c2)
        None    => test.assert(false)
        Some(h) => test.assert(not str.contains(h, "YStb"))

    test.case("a client that posts its credentials has no header")
    let c3 = oauthmsg.with_secret(oauthmsg.client("id", ""), "s", oauthmsg.OauthAuthPost)
    test.assert_none(oauthmsg.auth_header(c3))

    test.case("and a public client still sends its client_id in the body")
    let c4 = oauthmsg.client("public", "")
    test.assert(list.len(oauthmsg.with_client_auth(c4, [])) >= 1)

@test
fn test_a_body_is_form_urlencoded() [io]
    test.case("the pairs go out the way form-nv writes them")
    test.assert_eq_str(oauthmsg.encode_body([("grant_type", "refresh_token")]),
                       "grant_type=refresh_token")

@test
fn test_rfc_6749_5_1s_example_token_response_reads() [io]
    let at = a_moment()

    test.case("the example parses")
    match oauthmsg.read_token_response(rfc6749_token_response(), at)
        Err(_) => test.assert(false)
        Ok(t)  =>
            test.assert_eq_str(t.access_token, "2YotnFZFEjr1zCsicMWpAA")
            test.assert_eq_str(t.refresh_token, "tGzv3JOkF0XG5Qx2TlKWIA")

    test.case("a response with no access_token is refused — § 5.1 makes it REQUIRED")
    match oauthmsg.read_token_response("{\"token_type\":\"Bearer\"}", at)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("and one with no token_type is refused too, rather than defaulted")
    match oauthmsg.read_token_response("{\"access_token\":\"a\"}", at)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a body that is not JSON at all")
    match oauthmsg.read_token_response("<html>502</html>", at)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_an_error_response_becomes_the_faults_own_code() [io]
    test.case("§ 5.2's codes")
    test.assert_eq_str(oautherr.fault_code(
        oauthmsg.fault_of(400, "{\"error\":\"invalid_grant\"}")),
        "invalid_grant")

    test.case("a code this library does not know is kept verbatim")
    match oauthmsg.fault_of(400, "{\"error\":\"tenant_suspended\"}")
        OauthUnknownErrorCode(code, _) => test.assert_eq_str(code, "tenant_suspended")
        _                              => test.assert(false)

    test.case("a 500 with an HTML body is retryable rather than malformed")
    test.assert(oautherr.is_retryable(oauthmsg.fault_of(503, "<html>down</html>")))

@test
fn test_rfc_8628_3_2s_example_device_response_reads() [io]
    test.case("the example parses, user code and all")
    match oauthmsg.read_device_response(rfc8628_device_response())
        Err(_) => test.assert(false)
        Ok(g)  =>
            test.assert_eq_str(g.user_code, "WDJB-MJHT")
            test.assert_eq_str(g.verification_uri, "https://example.com/device")
            test.assert(g.expires_in == 1800)
            test.assert(g.interval == 5)

    test.case("an omitted interval defaults to § 3.5's five")
    match oauthmsg.read_device_response(
            "{\"device_code\":\"d\",\"user_code\":\"U\",\"verification_uri\":\"https://x/d\"}")
        Err(_) => test.assert(false)
        Ok(g)  => test.assert(g.interval == 5)

    test.case("a response with no device_code is refused")
    match oauthmsg.read_device_response("{\"user_code\":\"U\"}")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_the_device_prompt_shows_both_halves() [io]
    // § 3.3 requires the address AND the code to be shown, even where
    // `verification_uri_complete` is available.
    test.case("both are in the line")
    match oauthmsg.read_device_response(rfc8628_device_response())
        Err(_) => test.assert(false)
        Ok(g)  =>
            let line = oauthmsg.device_prompt(g)
            test.assert(str.contains(line, "WDJB-MJHT"))
            test.assert(str.contains(line, "https://example.com/device"))

// ── Exact bytes, from Python's urllib and hashlib ────────────────────
//
// The expected strings below were produced by `urllib.parse.urlencode`,
// `hashlib.sha256` and `base64` in Python, not by this package.

fn full_client() -> oauthmsg.OauthClient []
    oauthmsg.with_scopes(oauthmsg.client("s6BhdRkqt3", "https://client.example.com/cb"),
                         ["openid", "email"])

@test
fn test_the_authorization_url_is_byte_for_byte_what_python_writes() [io]
    let c = full_client()
    let p = oauthmsg.pending(c, "xyz", "n-0S6_WzA2Mj", rfc7636_verifier())
    match oauthmsg.authorize_url("https://server.example.com/authorize", c, p, [])
        Err(_) => test.fail("refused")
        Ok(u)  =>
            test.assert_eq_str(u,
                "https://server.example.com/authorize?response_type=code&client_id=s6BhdRkqt3&redirect_uri=https%3A%2F%2Fclient.example.com%2Fcb&scope=openid+email&state=xyz&nonce=n-0S6_WzA2Mj&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256")

    test.case("an endpoint that already has a query keeps it")
    match oauthmsg.authorize_url("https://server.example.com/authorize?tenant=a", c, p, [])
        Err(_) => test.fail("refused")
        Ok(u)  => test.assert(str.starts_with(u, "https://server.example.com/authorize?tenant=a&response_type=code"))
    match oauthmsg.authorize_url("https://server.example.com/authorize?", c, p, [])
        Err(_) => test.fail("refused")
        Ok(u)  => test.assert(str.starts_with(u, "https://server.example.com/authorize?response_type=code"))

    test.case("a plain-method client sends the verifier as the challenge")
    let plain_client = oauthmsg.with_pkce(c, oauthmsg.OauthPkcePlain)
    match oauthmsg.authorize_url("https://server.example.com/authorize", plain_client, p, [])
        Err(_) => test.fail("refused")
        Ok(u)  =>
            test.assert(str.contains(u, "code_challenge_method=plain"))
            test.assert(str.contains(u, "code_challenge=${rfc7636_verifier()}"))

@test
fn test_an_authorization_request_that_cannot_work_is_refused_by_name() [io]
    let c = full_client()
    let p = oauthmsg.pending(c, "xyz", "", rfc7636_verifier())
    test.case("no client_id")
    let no_id = oauthmsg.client("", "https://client.example.com/cb")
    match oauthmsg.authorize_url("https://id.example/a", no_id, oauthmsg.pending(no_id, "s", "", rfc7636_verifier()), [])
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "client_id"))
    test.case("no redirect_uri")
    let no_redirect = oauthmsg.client("id", "")
    match oauthmsg.authorize_url("https://id.example/a",
        no_redirect,
        oauthmsg.pending(no_redirect, "s", "", rfc7636_verifier()),
        [])
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "redirect_uri"))
    test.case("a verifier outside the grammar")
    match oauthmsg.authorize_url("https://id.example/a", c, oauthmsg.pending(c, "s", "", "short"), [])
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "code_verifier"))
    test.case("an endpoint that does not parse")
    match oauthmsg.authorize_url("not a url", c, p, [])
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert_eq_str(oautherr.fault_code(f), "")
    test.case("an extra parameter repeating another sent parameter, in either position")
    match oauthmsg.authorize_url("https://id.example/a", c, p, [("scope", "x")])
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "'scope'"))

@test
fn test_the_endpoint_check_reads_scheme_and_host() [io]
    test.assert(oauthmsg.endpoint_ok("HTTPS://id.example/a"))
    test.assert(oauthmsg.endpoint_ok("http://127.1.2.3/a"))
    test.assert(not oauthmsg.endpoint_ok("ftp://127.0.0.1/a"))
    test.assert(not oauthmsg.endpoint_ok("http://localhost/a"))
    test.assert(not oauthmsg.endpoint_ok("https:///a"))
    test.assert(not oauthmsg.endpoint_ok("no scheme"))

@test
fn test_scope_ok_follows_rfc_6749_3_3() [io]
    test.assert(oauthmsg.scope_ok("a"))
    test.assert(not oauthmsg.scope_ok(""))
    test.assert(not oauthmsg.scope_ok(" a"))
    test.assert(not oauthmsg.scope_ok("a "))
    test.assert(not oauthmsg.scope_ok("a  b"))
    test.assert(not oauthmsg.scope_ok("a\"b"))
    test.assert(not oauthmsg.scope_ok("a\\b"))
    test.assert(not oauthmsg.scope_ok("a\u{7f}b"))
    test.assert(oauthmsg.scope_ok("https://example.com/auth/drive"))

@test
fn test_verifiers_are_base64url_without_padding() [io]
    test.assert_eq_str(oauthmsg.verifier_of(bytes.from_byte_list([251, 255, 191])), "-_-_")
    test.assert_eq_str(oauthmsg.verifier_of(bytes.from_byte_list([255])), "_w")

@test
fn test_pkce_pairs_are_checked_both_ways() [io]
    test.assert(not oauthmsg.pkce_matches(rfc7636_verifier(), "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cX",
                                          oauthmsg.OauthPkceS256))
    test.assert(not oauthmsg.pkce_matches(rfc7636_verifier(), "short", oauthmsg.OauthPkceS256))
    test.assert(not oauthmsg.pkce_matches("short", "short", oauthmsg.OauthPkcePlain))
    test.assert(oauthmsg.pkce_matches(rfc7636_verifier(), rfc7636_verifier(), oauthmsg.OauthPkcePlain))

@test
fn test_a_client_that_holds_a_secret_by_assertion_is_confidential() [io]
    let c = oauthmsg.with_secret(oauthmsg.client("id", ""), "",
                                 oauthmsg.OauthAuthAssertion("urn:ietf:params:oauth:client-assertion-type:jwt-bearer", "a.b.c"))
    test.assert(oauthmsg.is_confidential(c))
    test.assert(not oauthmsg.is_confidential(oauthmsg.with_secret(oauthmsg.client("id", ""), "", oauthmsg.OauthAuthBasic)))

@test
fn test_callbacks_that_carry_more_or_less_than_one_answer() [io]
    test.case("a refusal carries its description and uri")
    match oauthmsg.read_callback("error=access_denied&error_description=No+thanks&error_uri=https%3A%2F%2Fe%2Fx&state=s")
        OauthCallbackRefused(e, d, u, s) =>
            test.assert_eq_str(e, "access_denied")
            test.assert_eq_str(d, "No thanks")
            test.assert_eq_str(u, "https://e/x")
            test.assert_eq_str(s, "s")
        _                                => test.fail("not a refusal")
    test.case("both a code and an error")
    match oauthmsg.read_callback("code=a&error=b&state=s")
        OauthCallbackUnreadable(d) => test.assert(str.contains(d, "both"))
        _                          => test.fail("read")
    test.case("a repeated error_description")
    match oauthmsg.read_callback("error=b&error_description=1&error_description=2")
        OauthCallbackUnreadable(d) => test.assert(str.contains(d, "error_description"))
        _                          => test.fail("read")
    test.case("neither, and the state of an unreadable one")
    test.assert_eq_str(oauthmsg.callback_state(oauthmsg.read_callback("x=1")), "")
    test.case("a callback with a code and no state keeps an empty state")
    test.assert_eq_str(oauthmsg.callback_state(oauthmsg.read_callback("code=a")), "")

@test
fn test_check_state_refuses_everything_it_cannot_trust() [io]
    let c = full_client()
    let p = oauthmsg.pending(c, "xyz", "", rfc7636_verifier())
    test.case("a flow that sent no state accepts no callback")
    let none = oauthmsg.pending(c, "", "", rfc7636_verifier())
    match oauthmsg.check_state(none, oauthmsg.read_callback("code=a"))
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "state"))
    test.case("a refusal with the wrong state is a mismatch, not the server's word")
    match oauthmsg.check_state(p, oauthmsg.read_callback("error=access_denied&state=other"))
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert_eq_str(oautherr.fault_code(f), "")
    test.case("an unreadable callback")
    match oauthmsg.check_state(p, oauthmsg.read_callback("nonsense=1"))
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "neither"))
    test.case("an empty code")
    match oauthmsg.check_state(p, oauthmsg.read_callback("code=&state=xyz"))
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "code"))
    test.case("an issuer the flow did not start against")
    let pi = oauthmsg.with_issuer(p, "https://id.example")
    match oauthmsg.check_state(pi, oauthmsg.read_callback("code=a&state=xyz&iss=https%3A%2F%2Fevil"))
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "refused the issuer"))
    test.case("no iss in the callback passes when the flow knows its issuer")
    match oauthmsg.check_state(pi, oauthmsg.read_callback("code=a&state=xyz"))
        Ok(code) => test.assert_eq_str(code, "a")
        Err(_)   => test.fail("refused")

@test
fn test_the_request_bodies_are_exact() [io]
    let v = rfc7636_verifier()
    test.case("client_secret_post sends id and secret in the body")
    let post = oauthmsg.with_secret(full_client(), "gX1fBat3bV", oauthmsg.OauthAuthPost)
    let p = oauthmsg.pending(post, "xyz", "", v)
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.code_params(post, p, "c o")),
                       "grant_type=authorization_code&code=c+o&redirect_uri=https%3A%2F%2Fclient.example.com%2Fcb&code_verifier=${v}&client_id=s6BhdRkqt3&client_secret=gX1fBat3bV")
    test.case("client_secret_basic leaves them to the header")
    let basic = oauthmsg.with_secret(full_client(), "gX1fBat3bV", oauthmsg.OauthAuthBasic)
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.refresh_params(basic, "r", ["a", "b"])),
                       "grant_type=refresh_token&refresh_token=r&scope=a+b")
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.refresh_params(basic, "r", [])),
                       "grant_type=refresh_token&refresh_token=r")
    test.case("a public client names itself")
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.client_credentials_params(full_client(), ["api"])),
                       "grant_type=client_credentials&scope=api&client_id=s6BhdRkqt3")
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.device_params(full_client(), [])),
                       "client_id=s6BhdRkqt3")
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.device_token_params(full_client(), "dc")),
                       "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code&device_code=dc&client_id=s6BhdRkqt3")
    test.case("post without a secret sends only the id")
    let nosecret = oauthmsg.with_secret(full_client(), "", oauthmsg.OauthAuthPost)
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.with_client_auth(nosecret, [])), "client_id=s6BhdRkqt3")
    test.case("an assertion client sends the signed assertion")
    let asr = oauthmsg.with_secret(full_client(), "", oauthmsg.OauthAuthAssertion("T", "a.b.c"))
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.with_client_auth(asr, [])),
                       "client_id=s6BhdRkqt3&client_assertion_type=T&client_assertion=a.b.c")
    test.case("revocation and introspection, with and without a hint")
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.revoke_params(basic, "t", "refresh_token")),
                       "token=t&token_type_hint=refresh_token")
    test.assert_eq_str(oauthmsg.encode_body(oauthmsg.introspect_params(basic, "t", "")), "token=t")

@test
fn test_the_basic_credential_is_form_encoded_then_base64ed_as_python_does() [io]
    let a = oauthmsg.with_secret(oauthmsg.client("id", ""), "a+b", oauthmsg.OauthAuthBasic)
    test.assert_eq_str(oauthmsg.auth_header(a) ?? "-", "Basic aWQ6YSUyQmI=")
    let b = oauthmsg.with_secret(oauthmsg.client("id", ""), "p%ss w:d", oauthmsg.OauthAuthBasic)
    test.assert_eq_str(oauthmsg.auth_header(b) ?? "-", "Basic aWQ6cCUyNXNzK3clM0Fk")

@test
fn test_token_responses_in_the_shapes_providers_send() [io]
    let at = a_moment()
    test.case("expires_in as a string of digits, with scope and id_token")
    match oauthmsg.read_token_response("{\"access_token\":\"a\",\"token_type\":\"Bearer\",\"expires_in\":\"60\",\"scope\":\"x y\",\"id_token\":\"i.d.t\"}",
        at)
        Err(_) => test.fail("refused")
        Ok(t)  =>
            test.assert_eq_str(t.scope, "x y")
            test.assert_eq_str(t.id_token, "i.d.t")
            test.assert_eq(oauthtoken.seconds_left(t, at) ?? 0 - 1, 60)
    test.case("no expires_in means no expiry, not an infinite one")
    match oauthmsg.read_token_response("{\"access_token\":\"a\",\"token_type\":\"Bearer\"}", at)
        Err(_) => test.fail("refused")
        Ok(t)  => test.assert(not oauthtoken.has_expiry(t))
    test.case("expires_in that is neither a number nor digits")
    match oauthmsg.read_token_response("{\"access_token\":\"a\",\"token_type\":\"Bearer\",\"expires_in\":\"soon\"}", at)
        Err(_) => test.fail("refused")
        Ok(t)  => test.assert(not oauthtoken.has_expiry(t))
    test.case("an expires_in past the calendar is an error")
    match oauthmsg.read_token_response("{\"access_token\":\"a\",\"token_type\":\"Bearer\",\"expires_in\":90000000000000000}", at)
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "calendar"))
    test.case("a 200 that carries an error, as GitHub sends")
    match oauthmsg.read_token_response("{\"error\":\"bad_verification_code\",\"error_description\":\"expired\"}", at)
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert_eq_str(oautherr.fault_description(f), "expired")
    match oauthmsg.read_token_response("{\"error\":\"bad_verification_code\"}", at)
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert_eq_str(oautherr.fault_description(f), "")
    test.case("an array is not a token response")
    match oauthmsg.read_token_response("[1]", at)
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "object"))

@test
fn test_every_status_the_error_reader_distinguishes() [io]
    match oauthmsg.fault_of(400,
        "{\"error\":\"invalid_grant\",\"error_description\":\"used\",\"error_uri\":\"https://e/x\"}")
        OauthInvalidGrant(d, u) =>
            test.assert_eq_str(d, "used")
            test.assert_eq_str(u, "https://e/x")
        _                       => test.fail("wrong fault")
    test.assert_eq_str(oautherr.fault_code(oauthmsg.fault_of(401, "")), "invalid_client")
    test.assert_eq_str(oautherr.fault_code(oauthmsg.fault_of(503, "")), "temporarily_unavailable")
    test.assert_eq_str(oautherr.fault_code(oauthmsg.fault_of(500, "oops")), "server_error")
    test.assert(oautherr.is_retryable(oauthmsg.fault_of(502, "")))
    test.assert(not oautherr.is_retryable(oauthmsg.fault_of(404, "not found")))
    test.case("a body that is JSON and not an object")
    test.assert_eq_str(oautherr.fault_code(oauthmsg.fault_of(400, "[1]")), "")
    test.case("an object whose error is not a string")
    test.assert(not oautherr.is_retryable(oauthmsg.fault_of(400, "{\"error\":5}")))

@test
fn test_device_responses_in_the_shapes_providers_send() [io]
    test.case("Google spells the address verification_url")
    match oauthmsg.read_device_response("{\"device_code\":\"d\",\"user_code\":\"U\",\"verification_url\":\"https://g/device\",\"expires_in\":1800,\"interval\":7}")
        Err(_) => test.fail("refused")
        Ok(g)  =>
            test.assert_eq_str(g.verification_uri, "https://g/device")
            test.assert_eq(g.interval, 7)
            test.assert_eq_str(g.verification_uri_complete, "")
    test.case("an absent expires_in is 900 and an interval below one is five")
    match oauthmsg.read_device_response("{\"device_code\":\"d\",\"user_code\":\"U\",\"verification_uri\":\"https://x/d\",\"interval\":0}")
        Err(_) => test.fail("refused")
        Ok(g)  =>
            test.assert_eq(g.expires_in, 900)
            test.assert_eq(g.interval, 5)
    test.case("each missing member is named")
    match oauthmsg.read_device_response("{\"device_code\":\"d\",\"verification_uri\":\"https://x/d\"}")
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "user_code"))
    match oauthmsg.read_device_response("{\"device_code\":\"d\",\"user_code\":\"U\"}")
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "verification_uri"))
    test.case("not JSON, and JSON that is not an object")
    match oauthmsg.read_device_response("<html>")
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "JSON"))
    match oauthmsg.read_device_response("[]")
        Ok(_)  => test.fail("accepted")
        Err(f) => test.assert(str.contains(f.message(), "object"))

@test
fn test_a_pending_flow_ages_in_whole_seconds() [io]
    let c = full_client()
    let at = a_moment()
    let p = oauthmsg.started_at(oauthmsg.pending(c, "s", "n", rfc7636_verifier()), at)
    match arith.add_delta(at, span.seconds(90))
        Err(_)  => test.fail("calendar")
        Ok(now) => test.assert_eq(oauthmsg.pending_age(p, now) ?? 0 - 1, 90)
    test.case("the redaction says when, and says undated when not")
    test.assert(str.contains(oauthmsg.pending_redacted(p), "started_at=2026-9-11"))
    test.assert(str.contains(oauthmsg.pending_redacted(oauthmsg.pending(c, "s", "n", "v")), "undated"))
    test.assert(str.contains(oauthmsg.pending_redacted(p), "verifier=<43 bytes>"))

@test
fn test_authorize_params_without_a_usable_verifier_omit_the_challenge() [io]
    let c = full_client()
    let ps = oauthmsg.authorize_params(c, oauthmsg.pending(c, "s", "", "short"), [("prompt", "login")])
    test.assert_eq(list.len(ps), 6)
    test.assert_eq_str(ps[5].0, "prompt")

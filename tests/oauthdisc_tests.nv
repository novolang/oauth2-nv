// oauthdisc_tests.nv — the two `.well-known` paths that are not the
// same URL, and the issuer check that is not optional.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: oauth2-nv.oauthdisc.<fn>`.
//
// THE URL ASSERTIONS ARE THE POINT OF THIS FILE.  OpenID Connect
// Discovery 1.0 § 4 APPENDS `/.well-known/openid-configuration` to the
// issuer; RFC 8414 § 3.1 INSERTS
// `/.well-known/oauth-authorization-server` between the host and the
// path.  For an issuer with no path they agree; for
// `https://id.example/tenant-a` — which is what every multi-tenant
// deployment looks like — they are different addresses.  The two
// examples below are the specifications' own.

use std.test
use std.list
use oauthdisc

// A discovery document with the four members every flow needs.
fn a_document() -> Str
    "{\"issuer\":\"https://id.example\","
        + "\"authorization_endpoint\":\"https://id.example/authorize\","
        + "\"token_endpoint\":\"https://id.example/token\","
        + "\"jwks_uri\":\"https://id.example/jwks\","
        + "\"code_challenge_methods_supported\":[\"S256\"],"
        + "\"id_token_signing_alg_values_supported\":[\"RS256\"],"
        + "\"grant_types_supported\":[\"authorization_code\",\"refresh_token\"]}"

@test
fn test_the_two_well_known_paths_agree_only_for_a_pathless_issuer() [io]
    test.case("no path: the same address")
    match oauthdisc.openid_url("https://id.example")
        Err(_) => test.assert(false)
        Ok(u)  => test.assert_eq_str(u, "https://id.example/.well-known/openid-configuration")

    match oauthdisc.oauth_url("https://id.example")
        Err(_) => test.assert(false)
        Ok(u)  => test.assert_eq_str(u,
            "https://id.example/.well-known/oauth-authorization-server")

    test.case("a path: OpenID Connect APPENDS")
    match oauthdisc.openid_url("https://id.example/tenant-a")
        Err(_) => test.assert(false)
        Ok(u)  => test.assert_eq_str(u,
            "https://id.example/tenant-a/.well-known/openid-configuration")

    test.case("and RFC 8414 INSERTS — a different address for the same issuer")
    match oauthdisc.oauth_url("https://id.example/tenant-a")
        Err(_) => test.assert(false)
        Ok(u)  => test.assert_eq_str(u,
            "https://id.example/.well-known/oauth-authorization-server/tenant-a")

@test
fn test_an_issuer_must_be_https_with_no_query_and_no_fragment() [io]
    test.case("http is refused")
    match oauthdisc.openid_url("http://id.example")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a query is refused — RFC 8414 § 2 forbids one")
    match oauthdisc.openid_url("https://id.example?tenant=a")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("and a fragment")
    match oauthdisc.oauth_url("https://id.example#x")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_both_urls_are_published_in_the_order_fetch_tries_them() [io]
    test.case("two of them, so a deployment behind a firewall can fetch them itself")
    let us = oauthdisc.discovery_urls("https://id.example/tenant-a")
    test.assert(list.len(us) == 2)

@test
fn test_a_document_parses_into_the_members_a_flow_needs() [io]
    test.case("the four required ones")
    match oauthdisc.read(a_document())
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.assert_eq_str(p.issuer, "https://id.example")
            test.assert_eq_str(p.token_endpoint, "https://id.example/token")
            test.assert_eq_str(p.jwks_uri, "https://id.example/jwks")

    test.case("a body with no issuer is refused — RFC 8414 § 2 makes it REQUIRED")
    match oauthdisc.read("{\"token_endpoint\":\"https://id.example/token\"}")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("and a body that is not JSON at all")
    match oauthdisc.read("<html>404</html>")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_the_issuer_check_is_exact_and_a_trailing_slash_is_a_different_issuer() [io]
    // § 4.3 says the comparison is exact.  Without the check, a
    // redirect from the discovery URL to somebody else's document
    // hands the client somebody else's token endpoint — and the client
    // then posts its authorization code, or its client secret, there.
    match oauthdisc.read(a_document())
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.case("the issuer it says it is")
            test.assert_none(oauthdisc.check_issuer(p, "https://id.example"))

            test.case("a trailing slash is NOT the same issuer")
            test.assert_some(oauthdisc.check_issuer(p, "https://id.example/"))

            test.case("and somebody else's")
            test.assert_some(oauthdisc.check_issuer(p, "https://evil.example"))

@test
fn test_an_empty_pkce_list_means_no_pkce_rather_than_probably_fine() [io]
    // RFC 8414 § 2: a server that omits
    // `code_challenge_methods_supported` does not support PKCE.  A
    // client that reads the absence as "probably fine" sends a
    // challenge the server ignores, and the exchange is then
    // unprotected with nothing saying so.
    test.case("the document says S256")
    match oauthdisc.read(a_document())
        Err(_) => test.assert(false)
        Ok(p)  => test.assert(oauthdisc.supports_pkce(p))

    test.case("a document that says nothing does not support it")
    match oauthdisc.read("{\"issuer\":\"https://id.example\"}")
        Err(_) => test.assert(false)
        Ok(p)  => test.assert(not oauthdisc.supports_pkce(p))

@test
fn test_an_absent_grant_list_is_the_specifications_default_and_not_everything() [io]
    match oauthdisc.read("{\"issuer\":\"https://id.example\"}")
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.case("§ 2's default is authorization_code and implicit")
            test.assert(oauthdisc.supports_grant(p, "authorization_code"))

            test.case("so refresh_token against a silent server is false")
            test.assert(not oauthdisc.supports_grant(p, "refresh_token"))

            test.case("and the auth-method default is client_secret_basic alone")
            test.assert(oauthdisc.supports_auth_method(p, "client_secret_basic"))
            test.assert(not oauthdisc.supports_auth_method(p, "client_secret_post"))

@test
fn test_missing_for_answers_every_gap_rather_than_the_first() [io]
    // A deployment that discovers its provider cannot do the device
    // flow wants to be told that once.
    test.case("a document with a token endpoint and no device endpoint")
    match oauthdisc.read(a_document())
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.assert(list.len(oauthdisc.missing_for(p, "device_code")) >= 1)
            test.assert(list.len(oauthdisc.missing_for(p, "authorization_code")) == 0)

@test
fn test_a_member_this_struct_does_not_model_is_still_readable() [io]
    test.case("the raw document is kept")
    match oauthdisc.read(a_document())
        Err(_) => test.assert(false)
        Ok(p)  => test.assert_none(oauthdisc.extra(p, "service_documentation"))

@test
fn test_a_jwks_skips_what_it_cannot_read_rather_than_refusing_the_set() [io]
    // A real JWKS carries a provider's whole key set, encryption keys
    // and all.  A client that refused the set because one member was
    // an `oct` key would be unable to verify anything.
    test.case("an empty set is a set")
    match oauthdisc.read_jwks("{\"keys\":[]}")
        Err(_) => test.assert(false)
        Ok(ks) => test.assert(list.len(ks) == 0)

    test.case("a body with no `keys` array is refused")
    match oauthdisc.read_jwks("{}")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("and what was skipped is readable, so a rotation that broke is visible")
    test.assert(list.len(oauthdisc.jwks_skipped("{\"keys\":[]}")) == 0)

@test
fn test_a_key_is_selected_by_kid_and_nothing_else() [io]
    test.case("no such kid")
    match oauthdisc.read_jwks("{\"keys\":[]}")
        Err(_) => test.assert(false)
        Ok(ks) => test.assert_none(oauthdisc.key_for(ks, "2026-09"))

@test
fn test_the_three_calls_that_reach_the_network() [io, net, async]
    // Nothing resolves `id.example`, so these assert only that they
    // answer rather than what they answer.  The day a body lands this
    // file is where a test double is pointed.
    test.case("discovery for an issuer")
    match oauthdisc.fetch("https://id.example")
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(true)

    test.case("discovery at an exact address, with the issuer check kept")
    match oauthdisc.fetch_at("https://mirror.example/oidc.json", "https://id.example")
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(true)

    test.case("and the key set")
    match oauthdisc.read(a_document())
        Err(_) => test.assert(false)
        Ok(p)  =>
            match oauthdisc.fetch_jwks(p)
                Ok(_)  => test.assert(true)
                Err(_) => test.assert(true)

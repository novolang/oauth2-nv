// oauthoidc_signed_tests.nv — id_tokens signed by OpenSSL, validated
// end to end, and the JWKS they are checked against.
//
// GENERATED by tests/generate/gen_oidc.py; do not edit by hand.  Every
// token, key and signature below was made by Python's `cryptography`
// (OpenSSL) and `hmac`, and checked there before it was written down, so
// nothing here is a signature this package could have produced.
//
// "Now" is 2026-09-11T00:00:00Z.  The tokens were issued a minute
// before it and live an hour, except the one that expired.

use std.test
use std.bytes
use std.list
use std.str
use civil
use jwtalg
use p256
use jwtpolicy
use oautherr
use oauthdisc
use oauthmsg
use oauthoidc

@@FIXTURES@@

fn now() -> civil.CivilDateTime []
    civil.datetime(civil.date_from_epoch_day(20707), civil.midnight())

fn provider(algs: Str) -> oauthdisc.OauthProvider []
    match oauthdisc.read("{\"issuer\":\"https://id.example\",\"token_endpoint\":\"https://id.example/token\",\"userinfo_endpoint\":\"\",\"id_token_signing_alg_values_supported\":${algs}}")
        Ok(p)  => p
        Err(_) => core.panic.panic("fixture provider did not parse")

fn client() -> oauthmsg.OauthClient []
    oauthmsg.client("my-client-id", "https://app.example/cb")

fn flow(nonce: Str) -> oauthmsg.OauthPending []
    oauthmsg.pending(client(), "state-value", nonce, "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")

fn keys() -> [jwtalg.JwtVerifyingKey] []
    match oauthdisc.read_jwks(jwks_document())
        Ok(ks) => ks
        Err(_) => core.panic.panic("fixture JWKS did not parse")

fn check(token: Str, algs: Str, nonce: Str, access: Str) -> Result<oauthoidc.OauthIdClaims, oautherr.OauthFault> []
    oauthoidc.validate(token, keys(), provider(algs), client(), flow(nonce), access, now())

fn rejected_with(r: Result<oauthoidc.OauthIdClaims, oautherr.OauthFault>, words: Str) -> Bool []
    match r
        Ok(_)  => false
        Err(f) => str.contains(f.message(), words)

@test
fn test_a_signed_id_token_validates_and_yields_its_claims() [io]
    match check(valid_es(), "[\"ES256\"]", "the-nonce", access_token())
        Err(f) => test.fail("refused: ${f.message()}")
        Ok(cl) =>
            test.assert_eq_str(cl.sub, "248289761001")
            test.assert_eq_str(cl.iss, "https://id.example")
            test.assert_eq_str(oauthoidc.identity(cl), "https://id.example 248289761001")
            test.assert_eq_str(oauthoidc.claim(cl, "email") ?? "-", "jane@example.com")
            test.assert(oauthoidc.claim_bool(cl, "email_verified") ?? false)

    test.case("with no access token to compare, at_hash is not checked")
    test.assert(is_ok(check(valid_es(), "[\"ES256\"]", "the-nonce", "")))

@test
fn test_each_refusal_names_its_step() [io]
    let es = "[\"ES256\"]"
    test.case("a nonce from another flow, and none at all, are both the replay check")
    match check(wrong_nonce(), es, "the-nonce", access_token())
        Err(OauthNonceMismatch(want, got)) =>
            test.assert_eq_str(want, "the-nonce")
            test.assert_eq_str(got, "another-nonce")
        _ => test.fail("expected a nonce mismatch")
    match check(no_nonce(), es, "the-nonce", access_token())
        Err(OauthNonceMismatch(_, got)) => test.assert_eq_str(got, "")
        _                               => test.fail("expected a nonce mismatch")
    test.case("a flow that sent no nonce checks none")
    test.assert(is_ok(check(wrong_nonce(), es, "", access_token())))

    test.case("an at_hash of another access token")
    test.assert(rejected_with(check(wrong_at_hash(), es, "the-nonce", access_token()), "at_hash"))
    test.case("an absent at_hash is allowed for the code flow")
    test.assert(is_ok(check(no_at_hash(), es, "the-nonce", access_token())))

    test.case("another issuer is the issuer mismatch")
    match check(wrong_iss(), es, "the-nonce", access_token())
        Err(OauthIssuerMismatch(want, got)) =>
            test.assert_eq_str(want, "https://id.example")
            test.assert_eq_str(got, "https://evil.example")
        _ => test.fail("expected an issuer mismatch")

    test.case("expiry and audience are jwt-nv's, reported under their code")
    test.assert(rejected_with(check(expired(), es, "the-nonce", access_token()), "expired"))
    test.assert(rejected_with(check(other_aud(), es, "the-nonce", access_token()), "audience"))

    test.case("a token jwt-nv accepts but that lacks a claim OpenID Connect requires")
    test.assert(rejected_with(check(no_iat(), es, "the-nonce", access_token()), "iat"))

    test.case("several audiences: azp must be this client")
    test.assert(rejected_with(check(two_aud_other_azp(), es, "the-nonce", access_token()), "authorized party"))
    test.assert(is_ok(check(two_aud_own_azp(), es, "the-nonce", access_token())))

    test.case("a key id nobody published, and a forged signature")
    test.assert(rejected_with(check(unknown_kid(), es, "the-nonce", access_token()), "nope"))
    test.assert(rejected_with(check(forged_es(), es, "the-nonce", access_token()), "signature"))

    test.case("not a token")
    test.assert(rejected_with(check("not.a.token", es, "the-nonce", access_token()), "not a JWT"))

@test
fn test_the_algorithm_list_is_the_documents_not_the_tokens() [io]
    test.case("an HS256 token against a provider that published ES256 only")
    let secret = jwtalg.hmac_verifying_key(bytes.from_str(hs_secret()))
    test.assert(rejected_with(oauthoidc.validate(hs_valid(), [secret], provider("[\"ES256\"]"), client(),
                                                 flow("the-nonce"), access_token(), now()), "HS256"))
    test.case("alg none is not representable")
    test.assert(rejected_with(check(none_alg(), "[\"ES256\", \"RS256\", \"HS256\"]", "the-nonce", access_token()), "none"))
    test.case("a provider that published nothing jwt-nv implements accepts nothing")
    test.assert_eq_str(oauthoidc.policy_algs(oauthoidc.policy_for(provider("[\"PS256\"]"), "c")), "")
    test.assert(rejected_with(check(valid_es(), "[\"PS256\"]", "the-nonce", access_token()), "nothing"))
    test.case("names jwt-nv does not implement are dropped from a mixed list")
    test.assert_eq_str(oauthoidc.policy_algs(oauthoidc.policy_for(provider("[\"RS512\", \"ES256\"]"), "c")), "ES256")
    test.case("a hand-built permissive policy lists all three")
    test.assert_eq_str(oauthoidc.policy_algs(jwtpolicy.permissive()), "HS256 RS256 ES256")

@test
fn test_an_hs256_token_validates_with_the_shared_secret() [io]
    let secret = jwtalg.hmac_verifying_key(bytes.from_str(hs_secret()))
    match oauthoidc.validate(hs_valid(), [secret], provider("[\"HS256\"]"), client(), flow("the-nonce"),
                             access_token(), now())
        Err(f) => test.fail("refused: ${f.message()}")
        Ok(cl) => test.assert_eq_str(cl.sub, "248289761001")

@test
fn test_rs256_is_declared_but_jwt_nv_cannot_verify_it_yet() [io]
    // A documented limitation, asserted so that the day jwt-nv verifies
    // RS256 this test fails and the README line goes.
    test.assert(rejected_with(check(rs_valid(), "[\"RS256\"]", "the-nonce", access_token()), "signature"))

@test
fn test_the_key_set_reads_ec_and_rsa_and_says_what_it_skipped() [io]
    let ks = keys()
    test.assert_eq(list.len(ks), 5)

    test.case("the EC key is the point OpenSSL made")
    match oauthdisc.key_for(ks, "ec1")
        None    => test.fail("no ec1")
        Some(k) =>
            test.assert_eq_str(jwtalg.alg_name(jwtalg.verifying_alg(k)), "ES256")
            match k.ec_public
                None    => test.fail("no point")
                Some(pt) => test.assert_eq_str(bytes.to_hex(bytes.from_byte_list(p256.public_key_bytes(pt))), ec_public_hex())

    test.case("the RSA key is PKCS#1 DER, byte for byte what OpenSSL writes (2048-bit: long length form)")
    match oauthdisc.key_for(ks, "rsa1")
        None    => test.fail("no rsa1")
        Some(k) => test.assert_eq_str(bytes.to_hex(k.rsa_der), rsa_der_hex())

    test.case("a short modulus uses the short length form, a middle one the one-byte long form")
    match oauthdisc.key_for(ks, "rsa512")
        None    => test.fail("no rsa512")
        Some(k) => test.assert_eq_str(bytes.to_hex(k.rsa_der), rsa512_der_hex())
    match oauthdisc.key_for(ks, "rsa1024")
        None    => test.fail("no rsa1024")
        Some(k) => test.assert_eq_str(bytes.to_hex(k.rsa_der), rsa1024_der_hex())

    test.case("an exponent written with leading zero bytes is the same key")
    match (oauthdisc.key_for(ks, "rsa1"), oauthdisc.key_for(ks, "rsa1zero"))
        (Some(a), Some(b)) => test.assert_eq_str(bytes.to_hex(a.rsa_der), bytes.to_hex(b.rsa_der))
        _                  => test.fail("missing")

    test.case("every skipped key is named with its reason")
    let skipped = oauthdisc.jwks_skipped(jwks_document())
    test.assert_eq(list.len(skipped), 10)
    test.assert(str.contains(str.join(skipped, "\n"), "enc1: the key is for 'enc'"))
    test.assert(str.contains(str.join(skipped, "\n"), "sym1: the key type 'oct'"))
    test.assert(str.contains(str.join(skipped, "\n"), "p384: the curve 'P-384'"))
    test.assert(str.contains(str.join(skipped, "\n"), "offcurve: p256: the point is not on the curve"))
    test.assert(str.contains(str.join(skipped, "\n"), "badb64: x and y are not base64url"))
    test.assert(str.contains(str.join(skipped, "\n"), "badrsa: n and e are not base64url"))
    test.assert(str.contains(str.join(skipped, "\n"), "emptyrsa: n and e must not be empty"))
    test.assert(str.contains(str.join(skipped, "\n"), "(no kid): a key with no kid cannot be selected"))
    test.assert(str.contains(str.join(skipped, "\n"), "nox: x and y are not base64url"))
    test.assert(str.contains(str.join(skipped, "\n"), "shortec: p256: expected 32 bytes"))

@test
fn test_a_key_set_that_is_not_one_is_refused_and_lists_nothing_skipped() [io]
    test.assert(rejected_set("<html>"))
    test.assert(rejected_set("{\"keys\":5}"))
    test.assert_eq(list.len(oauthdisc.jwks_skipped("<html>")), 0)

fn rejected_set(body: Str) -> Bool []
    match oauthdisc.read_jwks(body)
        Ok(_)  => false
        Err(_) => true

@test
fn test_claims_are_read_in_every_shape_a_provider_sends() [io]
    test.case("aud as one string")
    match oauthoidc.claims_of_verified("{\"iss\":\"i\",\"sub\":\"s\",\"aud\":\"c\",\"exp\":2,\"iat\":1,\"amr\":[\"pwd\",\"otp\"],\"auth_time\":7,\"acr\":\"1\",\"c_hash\":\"h\"}")
        Err(_) => test.fail("refused")
        Ok(cl) =>
            test.assert_eq(list.len(cl.aud), 1)
            test.assert_eq_str(cl.aud[0], "c")
            test.assert_eq(list.len(cl.amr), 2)
            test.assert_eq(cl.auth_time, 7)
            test.assert_eq_str(cl.acr, "1")
            test.assert_eq_str(cl.c_hash, "h")
    test.case("each required claim, absent, is named")
    test.assert(claims_miss("{\"sub\":\"s\",\"aud\":\"c\",\"exp\":2,\"iat\":1}", "iss"))
    test.assert(claims_miss("{\"iss\":\"i\",\"aud\":\"c\",\"exp\":2,\"iat\":1}", "sub"))
    test.assert(claims_miss("{\"iss\":\"i\",\"sub\":\"s\",\"exp\":2,\"iat\":1}", "aud"))
    test.assert(claims_miss("{\"iss\":\"i\",\"sub\":\"s\",\"aud\":\"c\",\"iat\":1}", "exp"))
    test.assert(claims_miss("{\"iss\":\"i\",\"sub\":\"s\",\"aud\":\"c\",\"exp\":2}", "iat"))
    test.assert(claims_miss("not json", "JSON"))

fn claims_miss(payload: Str, word: Str) -> Bool []
    match oauthoidc.claims_of_verified(payload)
        Ok(_)  => false
        Err(f) => str.contains(f.message(), word)

@test
fn test_the_azp_and_at_hash_checks_directly() [io]
    match oauthoidc.claims_of_verified("{\"iss\":\"i\",\"sub\":\"s\",\"aud\":[\"other\"],\"exp\":2,\"iat\":1,\"at_hash\":\"77QmUPtjPfzWtF2AnpK9RQ\"}")
        Err(_) => test.fail("refused")
        Ok(cl) =>
            test.case("a single audience that is not this client")
            test.assert_some(oauthoidc.check_azp(cl, "c"))
            test.case("the OpenID Connect Core example at_hash, under every algorithm jwt-nv has")
            let tok = "jHkWEdUXMU1BwAsC4vtUsZwnNvTIxEl0z9K3vx5KF0Y"
            test.assert_none(oauthoidc.check_at_hash(cl, tok, jwtalg.Hs256))
            test.assert_none(oauthoidc.check_at_hash(cl, tok, jwtalg.Rs256))
            test.assert_none(oauthoidc.require_at_hash(cl, tok, jwtalg.Es256))
            test.assert_some(oauthoidc.check_at_hash(cl, "another", jwtalg.Es256))
            match oauthoidc.at_hash_of(tok, jwtalg.Es256)
                Ok(h)  => test.assert_eq_str(h, "77QmUPtjPfzWtF2AnpK9RQ")
                Err(_) => test.fail("at_hash_of refused")

@test
fn test_the_userinfo_checks_that_need_no_network() [io]
    match oauthoidc.claims_of_verified("{\"iss\":\"i\",\"sub\":\"s1\",\"aud\":\"c\",\"exp\":2,\"iat\":1}")
        Err(_) => test.fail("refused")
        Ok(cl) =>
            test.assert_none(oauthoidc.check_userinfo_sub("{\"sub\":\"s1\"}", cl))
            test.assert_some(oauthoidc.check_userinfo_sub("{\"sub\":\"s2\"}", cl))
            test.assert_some(oauthoidc.check_userinfo_sub("{}", cl))
            test.assert_some(oauthoidc.check_userinfo_sub("<html>", cl))
            test.case("a provider with no userinfo endpoint, and one that is not https")
            match oauthoidc.fetch_userinfo(provider("[]"), "tok")
                Ok(_)  => test.fail("fetched")
                Err(f) => test.assert(str.contains(f.message(), "userinfo_endpoint"))
            match oauthdisc.read("{\"issuer\":\"i\",\"userinfo_endpoint\":\"http://id.example/userinfo\"}")
                Err(_) => test.fail("refused")
                Ok(p)  =>
                    match oauthoidc.fetch_userinfo(p, "tok")
                        Ok(_)  => test.fail("fetched")
                        Err(f) => test.assert(str.contains(f.message(), "not https"))

fn is_ok(r: Result<oauthoidc.OauthIdClaims, oautherr.OauthFault>) -> Bool []
    match r
        Ok(_)  => true
        Err(_) => false

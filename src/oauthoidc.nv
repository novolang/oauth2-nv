// oauthoidc.nv — the id_token, validated.  A policy over jwt-nv, not a
// second JWT verifier.
//
// Every body here is a `todo()`; the signatures are the design.
//
// WHY THIS IS NOT A VERIFIER.  jwt-nv already holds the algorithm
// allow-list, the signature check, the `exp`/`nbf`/`iat` arithmetic,
// the issuer and audience requirement, the leeway and the maximum
// lifetime — all of it, tested against its own vectors.  OpenID
// Connect Core § 3.1.3.7 adds exactly three checks on top of that
// (`nonce`, `azp`, `at_hash`) and one configuration rule (the
// algorithm comes from the DISCOVERY DOCUMENT, never from the token's
// own header).  Writing a second verifier here would be writing a
// second place for `alg: none` to get in.
//
// So `policy_for` is the interesting function: it turns an
// `OauthProvider` and a `client_id` into a `JwtPolicy` with the
// issuer, the audience and the allowed algorithms already set from
// what the SERVER published.  A caller who builds a policy by hand can
// get any of those wrong; a caller who calls this cannot.
//
// THE ALGORITHM LIST COMES FROM THE DOCUMENT.  This is the check that
// stops the oldest JWT attack there is.  A token's header says what it
// is signed with, and a verifier that believes it accepts `none`, or
// accepts an HMAC signed with the provider's PUBLIC key as if it were
// RSA.  `policy_for` reads `id_token_signing_alg_values_supported`,
// which is the server's own statement, and a provider that published
// nothing gets `RS256` — OpenID Connect Core § 15.1 makes that the one
// algorithm an implementation must support, so it is the only safe
// default.
//
// `at_hash` IS THE PART EVERYBODY SKIPS, and it is the only thing tying
// an id_token to the access token that arrived beside it.  Without it
// a client that receives `(id_token for Alice, access_token for
// Mallory)` — which a compromised or confused authorization server can
// produce — signs Alice in and then calls the resource server as
// Mallory.  Optional in the specification for the code flow, checked
// here whenever the claim is present, and `check_at_hash` is public so
// a caller can require it.

use civil
use jwtalg
use jwtpolicy
use oautherr
use oauthdisc
use oauthmsg

// An id_token's claims, after validation (OpenID Connect Core § 2).
//
// The six REQUIRED claims are strings and integers; the rest are
// present often enough to model and empty when absent.  `raw_json` is
// the whole payload, for the claims a provider adds — `email`,
// `name`, `groups`, `hd` — which are what an application actually
// wants and which no specification standardises the set of.
pub struct OauthIdClaims
    // REQUIRED.  The issuer.  Checked against the flow's.
    iss: Str
    // REQUIRED.  The end user's identifier AT THIS ISSUER.  The
    // primary key an application should store, alone or paired with
    // `iss` — an email address is not it, because an email address can
    // be reassigned and a `sub` cannot.
    sub: Str
    // REQUIRED.  The audiences, which must contain this `client_id`.
    aud: [Str]
    // REQUIRED.  Expiry, in Unix seconds.
    exp: Int
    // REQUIRED.  Issued-at, in Unix seconds.
    iat: Int
    // The value this flow sent, echoed.  REQUIRED whenever the
    // authorization request carried one.
    nonce: Str
    // When the end user authenticated, in Unix seconds; zero when
    // absent.  Required only when `max_age` was requested.
    auth_time: Int
    // The authorized party: which client this token was issued FOR.
    // Required when `aud` has more than one member.
    azp: Str
    // The authentication context class.
    acr: Str
    // How the end user authenticated — `pwd`, `otp`, `hwk`.
    amr: [Str]
    // The access token's hash (§ 3.1.3.6).  Empty when absent.
    at_hash: Str
    // The authorization code's hash (§ 3.3.2.11), for the hybrid
    // flows.  Empty for the code flow, which this package uses.
    c_hash: Str
    // The whole payload, for the claims an application wants and this
    // struct does not model.
    raw_json: Str

// A jwt-nv policy built from what the SERVER published.
//
// The issuer is the provider's, the audience is this `client_id`, and
// the allowed algorithms are the provider's
// `id_token_signing_alg_values_supported` — never the token's own
// header, which is the oldest JWT attack there is.  A provider that
// published no algorithm list gets `RS256` alone: OpenID Connect Core
// § 15.1 makes it the one an implementation must support, so it is the
// only safe default.
//
// `max_lifetime` is set, because an id_token is a login assertion and
// one valid for a year is one a stolen browser profile replays for a
// year.
//
// ```novo
// use oauthdisc
// use oauthoidc
//
// fn main() [io]
//     match oauthdisc.read("{}")
//         Err(_) => println("no")
//         Ok(p)  =>
//             let pol = oauthoidc.policy_for(p, "my-client-id")
//             println("${oauthoidc.policy_algs(pol)}")
// ```
pub fn policy_for(p: oauthdisc.OauthProvider, client_id: Str) -> jwtpolicy.JwtPolicy []
    todo("oauth2-nv.oauthoidc.policy_for")

// The algorithms a policy admits, as one space-joined string.
//
// For a diagnostic: an id_token refused for its algorithm is refused
// with a list, and a person reading a log needs to see which list.
//
// ```novo
// use jwtpolicy
// use oauthoidc
//
// fn main() [io]
//     println(oauthoidc.policy_algs(jwtpolicy.strict()))
// ```
pub fn policy_algs(p: jwtpolicy.JwtPolicy) -> Str []
    todo("oauth2-nv.oauthoidc.policy_algs")

// Validate an id_token whole: signature, claims, and OpenID Connect's
// three extra checks.
//
// The one call a client makes.  In order (§ 3.1.3.7):
//
//   1. jwt-nv verifies the signature against the key whose `kid` the
//      header names, under the policy `policy_for` built;
//   2. `iss` against the provider's issuer;
//   3. `aud` contains the `client_id`, and `azp` is the `client_id`
//      where `aud` has more than one member;
//   4. `exp` and `iat` against `now`, with the policy's leeway;
//   5. `nonce` against the pending flow's, when the flow sent one;
//   6. `at_hash` against the access token, when the claim is present.
//
// Every refusal names which step, because "the id_token was rejected"
// is not something a deployment can act on.
//
// ```novo
// use civil
// use oauthdisc
// use oauthmsg
// use oauthoidc
//
// fn main() [io]
//     match civil.date(2026, 9, 11)
//         Err(_) => println("no")
//         Ok(d)  =>
//             let now = civil.datetime(d, civil.midnight())
//             let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//             let p = oauthmsg.pending(c, "st", "nonce-value", "v")
//             match oauthdisc.read("{}")
//                 Err(_) => println("no provider")
//                 Ok(pr) =>
//                     match oauthoidc.validate("a.b.c", [], pr, c, p, "", now)
//                         Ok(cl) => println(cl.sub)
//                         Err(_) => println("the id_token was refused")
// ```
pub fn validate(id_token: Str, keys: [jwtalg.JwtVerifyingKey], p: oauthdisc.OauthProvider,
                c: oauthmsg.OauthClient, pending: oauthmsg.OauthPending, access_token: Str,
                now: civil.CivilDateTime) -> Result<OauthIdClaims, oautherr.OauthFault> []
    todo("oauth2-nv.oauthoidc.validate")

// The claims of an id_token that has ALREADY been verified.
//
// The parse alone, for a caller that verified elsewhere — a gateway
// that did the signature check, a test.  Named this way rather than
// `read_claims` because a reader who sees the name and uses it on an
// unverified token has been told.
//
// ```novo
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Ok(c)  => println(c.sub)
//         Err(_) => println("not an id_token payload")
// ```
pub fn claims_of_verified(payload_json: Str) -> Result<OauthIdClaims, oautherr.OauthFault> []
    todo("oauth2-nv.oauthoidc.claims_of_verified")

// The `nonce` check (§ 3.1.3.7 step 11).
//
// `None` when the claim equals what the flow sent, or when the flow
// sent none.  A flow that DID send one and got a token carrying none
// is refused: that is a token minted for another request.
//
// ```novo
// use oauthmsg
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Err(_) => println("no")
//         Ok(cl) =>
//             let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//             let p = oauthmsg.pending(c, "st", "n", "v")
//             match oauthoidc.check_nonce(cl, p)
//                 Some(_) => println("replayed")
//                 None    => println("this flow's token")
// ```
pub fn check_nonce(cl: OauthIdClaims, p: oauthmsg.OauthPending) -> ?oautherr.OauthFault []
    todo("oauth2-nv.oauthoidc.check_nonce")

// The `azp` check (§ 3.1.3.7 steps 4 and 5).
//
// `None` when `aud` has one member equal to the `client_id`, or when
// `azp` is present and equal to it.  A token whose `aud` names several
// clients and whose `azp` names another is a token issued for someone
// else — which a client that only checked `aud` would accept.
//
// ```novo
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Err(_) => println("no")
//         Ok(cl) =>
//             match oauthoidc.check_azp(cl, "my-client-id")
//                 Some(_) => println("issued for another client")
//                 None    => println("ours")
// ```
pub fn check_azp(cl: OauthIdClaims, client_id: Str) -> ?oautherr.OauthFault []
    todo("oauth2-nv.oauthoidc.check_azp")

// The `at_hash` for an access token under a signing algorithm
// (§ 3.1.3.6).
//
// The left half of the hash of the ASCII of the access token,
// base64url without padding — where the hash is the one the algorithm
// names: SHA-256 for `RS256`, `ES256` and `HS256`, and so on up.  A
// client computing it with the wrong hash gets a mismatch on a correct
// token, which is why this is one function rather than a paragraph.
//
// ```novo
// use jwtalg
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.at_hash_of("ya29.example", Rs256)
//         Ok(h)  => println(h)
//         Err(_) => println("no hash for that algorithm")
// ```
pub fn at_hash_of(access_token: Str, alg: jwtalg.JwtAlg) -> Result<Str, oautherr.OauthFault> []
    todo("oauth2-nv.oauthoidc.at_hash_of")

// The `at_hash` check (§ 3.1.3.6).
//
// `None` when the claim matches the access token, and `None` when the
// claim is ABSENT — because the specification makes it optional for
// the code flow.  `require_at_hash` is the caller who is not satisfied
// with that, and a client talking to one provider it controls should
// use it: this is the only claim tying an id_token to the access token
// that arrived beside it, and without it a mixed-up pair signs one
// person in and calls the API as another.
//
// ```novo
// use jwtalg
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Err(_) => println("no")
//         Ok(cl) =>
//             match oauthoidc.check_at_hash(cl, "ya29.example", Rs256)
//                 Some(_) => println("the tokens do not belong together")
//                 None    => println("paired, or the provider did not say")
// ```
pub fn check_at_hash(cl: OauthIdClaims, access_token: Str,
                     alg: jwtalg.JwtAlg) -> ?oautherr.OauthFault []
    todo("oauth2-nv.oauthoidc.check_at_hash")

// The same check, refusing an ABSENT claim.
//
// For the client that requires the pairing rather than accepting the
// provider's silence about it.
//
// ```novo
// use jwtalg
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Err(_) => println("no")
//         Ok(cl) =>
//             match oauthoidc.require_at_hash(cl, "ya29.example", Rs256)
//                 Some(_) => println("no pairing")
//                 None    => println("paired")
// ```
pub fn require_at_hash(cl: OauthIdClaims, access_token: Str,
                       alg: jwtalg.JwtAlg) -> ?oautherr.OauthFault []
    todo("oauth2-nv.oauthoidc.require_at_hash")

// The stable identity of the end user: the issuer and the subject,
// together.
//
// A `sub` is unique WITHIN an issuer and nowhere else, so an
// application that keys its own accounts on `sub` alone breaks the
// moment it accepts a second provider — and it breaks by MERGING two
// people who happen to share a subject string.  This is the key to
// store.
//
// ```novo
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Err(_) => println("no")
//         Ok(cl) => println(oauthoidc.identity(cl))
// ```
pub fn identity(cl: OauthIdClaims) -> Str []
    todo("oauth2-nv.oauthoidc.identity")

// A claim this struct does not model, as a string.
//
// `email`, `name`, `picture`, `hd`, `groups` — the claims an
// application actually wants, none of which OpenID Connect requires a
// provider to send.
//
// ```novo
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Err(_) => println("no")
//         Ok(cl) =>
//             match oauthoidc.claim(cl, "email")
//                 Some(v) => println(v)
//                 None    => println("the provider did not send one")
// ```
pub fn claim(cl: OauthIdClaims, name: Str) -> ?Str []
    todo("oauth2-nv.oauthoidc.claim")

// A boolean claim, for `email_verified` and its neighbours.
//
// `None` where the claim is absent or is not a boolean — and the
// difference between `None` and `Some(false)` is the one that matters:
// an application that treats an absent `email_verified` as `true` has
// just let anyone claim anyone's address.
//
// ```novo
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Err(_) => println("no")
//         Ok(cl) =>
//             match oauthoidc.claim_bool(cl, "email_verified")
//                 Some(v) => println("${v}")
//                 None    => println("the provider did not say")
// ```
pub fn claim_bool(cl: OauthIdClaims, name: Str) -> ?Bool []
    todo("oauth2-nv.oauthoidc.claim_bool")

// Fetch the userinfo endpoint with an access token
// (OpenID Connect Core § 5.3), as raw JSON.
//
// Raw for the same reason introspection is: the claims a provider
// returns here are the provider's own set.  The one function in this
// module that performs anything.
//
// § 5.3.4 requires a client to check that the `sub` in the userinfo
// response equals the `sub` in the id_token, and `check_userinfo_sub`
// is that check — an unchecked userinfo response is another way to
// attach one person's profile to another's session.
//
// ```novo
// use oauthoidc
// use oauthdisc
//
// fn main() [io, net, async]
//     match oauthdisc.read("{}")
//         Err(_) => println("no")
//         Ok(p)  =>
//             match oauthoidc.fetch_userinfo(p, "ya29.example")
//                 Ok(doc) => println(doc)
//                 Err(_)  => println("no userinfo")
// ```
pub fn fetch_userinfo(p: oauthdisc.OauthProvider,
                      access_token: Str) -> Result<Str, oautherr.OauthFault> [net, async]
    todo("oauth2-nv.oauthoidc.fetch_userinfo")

// The `sub` check on a userinfo response (§ 5.3.4).
//
// `None` when the response's `sub` equals the id_token's.
//
// ```novo
// use oauthoidc
//
// fn main() [io]
//     match oauthoidc.claims_of_verified("{}")
//         Err(_) => println("no")
//         Ok(cl) =>
//             match oauthoidc.check_userinfo_sub("{}", cl)
//                 Some(_) => println("another end user's profile")
//                 None    => println("the same end user")
// ```
pub fn check_userinfo_sub(userinfo_json: Str, cl: OauthIdClaims) -> ?oautherr.OauthFault []
    todo("oauth2-nv.oauthoidc.check_userinfo_sub")

// oauthflow.nv — the four client flows, performed.  The only module in
// this package that opens a socket or reads a generator.
//
// `post_form` is the one exchange: a form body to an endpoint, the
// client's `Authorization` header added where the client uses one, the
// reply read as a string on a 2xx and as a fault on anything else.
// Every flow below is `oauthmsg` arithmetic, one `post_form`, and more
// `oauthmsg` arithmetic. A reader asking where this module reaches the
// network reads one function. Discovery, the key set and userinfo are
// the other requests in the package, and each is a single GET in
// `oauthdisc` and `oauthoidc`.
//
// A redirect is never followed. A token endpoint that answers 307
// would otherwise receive the client's secret at the address it names.
//
// Two rows are wider than they look.
//
// `[fs, rand]` on the minting functions. `state`, `nonce` and the PKCE
// verifier are the three values whose purpose is that an attacker cannot
// predict them. The standard library's `rand` module is xoshiro256**,
// which is not a cryptographic generator, so these go through rand-nv's
// `rng.os_bytes`. On this platform the operating system's generator is
// the device `/dev/urandom`, and reading a device is `[fs]`. `begin_from`
// is for a caller who brought their own values, and it is `[]`.
//
// `[io, net, time, async]` on every exchange. `HttpClient` is the one
// HTTP client in the standard library that answers the status and body
// of an error reply, which OAuth 2 needs: `invalid_grant` and
// `authorization_pending` both arrive as a 400. The one-shot
// `http.client.post` returns only the body of a 2xx.
//
// `device_wait` sleeps between polls, and it is the only function here
// that does. `device_poll` is one poll and does not sleep, so the loop
// can be the caller's, which matters for a program that has to draw a
// spinner, answer a cancel key or serve other requests while it waits.

use std.bytes
use std.json
use std.time
use civil
use oautherr
use rng
use oauthmsg
use oauthtoken

// ── Minting the unpredictable values ─────────────────────────────────

// A fresh `state`, from the operating system's generator.
//
// `OauthNoEntropy` where there is no generator — a flow refuses rather
// than continuing with something guessable, because a predictable
// `state` is a `state` check that passes for an attacker.
//
// ```novo
// use oauthflow
//
// // Minting reads the operating system's generator, which is beyond
// // [io], so the example writes its own `main`.
// fn main() [io, fs, rand]
//     match oauthflow.new_state()
//         Ok(s)  => println("${str.len(s)}")
//         Err(_) => println("no generator on this machine")
// ```
pub fn new_state() -> Result<Str, oautherr.OauthFault> [fs, rand]
    armour(rng.os_bytes(oauthmsg.state_bytes()))

// A fresh `nonce`, from the same generator.
//
// ```novo
// use oauthflow
//
// fn main() [io, fs, rand]
//     match oauthflow.new_nonce()
//         Ok(n)  => println("${str.len(n)}")
//         Err(_) => println("no generator on this machine")
// ```
pub fn new_nonce() -> Result<Str, oautherr.OauthFault> [fs, rand]
    armour(rng.os_bytes(oauthmsg.state_bytes()))

// A fresh PKCE `code_verifier`: `oauthmsg.verifier_bytes()` random
// bytes, base64url without padding.
//
// ```novo
// use oauthflow
//
// fn main() [io, fs, rand]
//     match oauthflow.new_verifier()
//         Ok(v)  => println("${str.len(v)}")
//         Err(_) => println("no generator on this machine")
// ```
pub fn new_verifier() -> Result<Str, oautherr.OauthFault> [fs, rand]
    armour(rng.os_bytes(oauthmsg.verifier_bytes()))

// ── Starting a flow ──────────────────────────────────────────────────

// Mint a pending flow: a `state`, a PKCE verifier, and — when
// `want_nonce` — a `nonce`.
//
// The value to store between sending the end user away and receiving
// them back.  It holds a secret, so it is stored the way a secret is:
// a server-side session, an encrypted cookie, or a table row that is
// deleted on use.
//
// `want_nonce` is a parameter rather than always-on because the
// `nonce` is only meaningful with an id_token — a plain OAuth 2 flow
// that sends one is sending a parameter the server echoes nowhere.
//
// ```novo
// use oauthflow
// use oauthmsg
//
// fn main() [io, fs, rand]
//     let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//     match oauthflow.begin(c, true)
//         Ok(p)  => println("${str.len(p.state)}")
//         Err(_) => println("no generator on this machine")
// ```
pub fn begin(c: oauthmsg.OauthClient,
             want_nonce: Bool) -> Result<oauthmsg.OauthPending, oautherr.OauthFault> [fs, rand]
    let empty = Some(bytes.zeros(0))
    begin_from_draws(c, rng.os_bytes(oauthmsg.state_bytes()),
                     (if want_nonce then rng.os_bytes(oauthmsg.state_bytes()) else empty),
                     rng.os_bytes(oauthmsg.verifier_bytes()))

// The same, with the randomness supplied.
//
// `[]`, and that is the point: a test asserts an exact authorization
// URL against fixed values, and a caller with its own generator — a
// hardware token, a seeded source in a simulation — uses it rather
// than the one this package would read.  Refuses a verifier outside
// RFC 7636 § 4.1's grammar, because a flow that starts with one is a
// flow that fails at the exchange.
//
// ```novo
// use oauthflow
// use oauthmsg
//
// fn main() [io]
//     let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//     let v = "0123456789012345678901234567890123456789012"
//     match oauthflow.begin_from(c, "state-value", "", v)
//         Ok(p)  => println(p.state)
//         Err(_) => println("that is not a verifier")
// ```
pub fn begin_from(c: oauthmsg.OauthClient, state: Str, nonce: Str,
                  verifier: Str) -> Result<oauthmsg.OauthPending, oautherr.OauthFault> []
    if state == ""
        Err(oautherr.OauthInvalidRequest("a flow needs a state; an empty one checks nothing", ""))
    else
        match oauthmsg.pkce_challenge(verifier, c.pkce)
            Err(f) => Err(f)
            Ok(_)  => Ok(oauthmsg.pending(c, state, nonce, verifier))

// ── The one exchange ─────────────────────────────────────────────────

// A form body to a token-shaped endpoint, with this client's
// credentials attached, and the reply as a string.
//
// The request every flow below is built on: the parameters as a form
// body, and the reply as a string.
//
// The parameters already carry the client's body credentials, which the
// `oauthmsg.*_params` functions add; this function adds only the
// `Authorization` header of a `client_secret_basic` client. Answers the
// body on a 2xx and a fault on anything else, with `oauthmsg.fault_of`
// reading the error document, so a caller that wants the raw body of a
// non-standard endpoint gets a string and parses it itself.
//
// Refuses an endpoint that is not `https` before opening anything. The
// one exception is a loopback address, RFC 8252 section 8.3. A redirect
// is not followed.
//
// ```novo
// use oauthflow
// use oauthmsg
//
// fn main() [io, net, time, async]
//     let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//     match oauthflow.post_form("https://id.example/token", c, [("grant_type", "x")])
//         Ok(body) => println(body)
//         Err(_)   => println("the exchange failed")
// ```
pub fn post_form(endpoint: Str, c: oauthmsg.OauthClient,
                 params: [(Str, Str)]) -> Result<Str, oautherr.OauthFault> [io, net, time, async]
    if not oauthmsg.endpoint_ok(endpoint)
        Err(oautherr.OauthInsecureEndpoint(endpoint))
    else
        var client = HttpClient.new("").with_redirects(0)
            .with_header("Content-Type", "application/x-www-form-urlencoded")
            .with_header("Accept", "application/json")
        match oauthmsg.auth_header(c)
            Some(h) =>
                client = client.with_header("Authorization", h)
            None    => ()
        match client.post(endpoint, oauthmsg.encode_body(params))
            Err(e)    => Err(oautherr.OauthTransport(http.client.error_text(e)))
            Ok(reply) =>
                if reply.status >= 200 and reply.status < 300
                    Ok(http.client.text(reply))
                else
                    Err(oauthmsg.fault_of(reply.status, http.client.text(reply)))

// ── Authorization code with PKCE ─────────────────────────────────────

// The address to send the end user to — `oauthmsg.authorize_url`,
// named here so the two halves of the flow are found together.
//
// ```novo
// use oauthflow
// use oauthmsg
//
// fn main() [io]
//     let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//     let v = "0123456789012345678901234567890123456789012"
//     match oauthflow.begin_from(c, "st", "", v)
//         Err(_) => println("no")
//         Ok(p)  =>
//             match oauthflow.authorize_url("https://id.example/authorize", c, p)
//                 Ok(u)  => println(u)
//                 Err(_) => println("refused")
// ```
pub fn authorize_url(endpoint: Str, c: oauthmsg.OauthClient,
                     p: oauthmsg.OauthPending) -> Result<Str, oautherr.OauthFault> []
    oauthmsg.authorize_url(endpoint, c, p, [])

// Exchange an authorization code for a token (RFC 6749 § 4.1.3,
// RFC 7636 § 4.5).
//
// TAKES THE `OauthPending`, and that is the design: there is no
// signature in this package that exchanges a code without the state
// the flow sent, so the CSRF check is an argument rather than a step a
// caller can forget.  The check runs here even for a caller that
// already ran `oauthmsg.check_state` — the cheap check is not the one
// that has to be trusted.
//
// `arrived_at` is what `expires_in` is counted from; pass a reading
// taken before the call and the expiry errs early, which is the safe
// direction.
//
// ```novo
// use civil
// use oauthflow
// use oauthmsg
//
// fn main() [io, net, time, async]
//     match civil.date(2026, 9, 11)
//         Err(_) => println("no")
//         Ok(d)  =>
//             let now = civil.datetime(d, civil.midnight())
//             let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//             let v = "0123456789012345678901234567890123456789012"
//             match oauthflow.begin_from(c, "st", "", v)
//                 Err(_) => println("no")
//                 Ok(p)  =>
//                     let cb = oauthmsg.read_callback("code=abc&state=st")
//                     match oauthflow.exchange_code("https://id.example/token", c, p, cb, now)
//                         Ok(t)  => println(t.access_token)
//                         Err(_) => println("the exchange failed")
// ```
pub fn exchange_code(endpoint: Str, c: oauthmsg.OauthClient, p: oauthmsg.OauthPending,
                     cb: oauthmsg.OauthCallback,
                     arrived_at: civil.CivilDateTime) -> Result<oauthtoken.OauthToken, oautherr.OauthFault> [io, net, time, async]
    match oauthmsg.check_state(p, cb)
        Err(f)   => Err(f)
        Ok(code) =>
            match post_form(endpoint, c, oauthmsg.code_params(c, p, code))
                Err(f)   => Err(f)
                Ok(body) => oauthmsg.read_token_response(body, arrived_at)

// ── Client credentials ───────────────────────────────────────────────

// A token in this program's own name (RFC 6749 § 4.4).
//
// Refuses a public client before sending anything: this grant
// authenticates the CLIENT and a client with no credentials has
// nothing to authenticate with, so the request would come back
// `invalid_client` and the refusal here names the cause.
//
// ```novo
// use civil
// use oauthflow
// use oauthmsg
//
// fn main() [io, net, time, async]
//     match civil.date(2026, 9, 11)
//         Err(_) => println("no")
//         Ok(d)  =>
//             let now = civil.datetime(d, civil.midnight())
//             let c = oauthmsg.with_secret(oauthmsg.client("svc", ""), "s",
//                                          oauthmsg.OauthAuthBasic)
//             match oauthflow.client_credentials("https://id.example/token", c, ["api"], now)
//                 Ok(t)  => println(t.access_token)
//                 Err(_) => println("the exchange failed")
// ```
pub fn client_credentials(endpoint: Str, c: oauthmsg.OauthClient, scopes: [Str],
                          arrived_at: civil.CivilDateTime) -> Result<oauthtoken.OauthToken, oautherr.OauthFault> [io, net, time, async]
    if not oauthmsg.is_confidential(c)
        Err(oautherr.OauthInvalidClient("a public client has no credentials for the client credentials grant", ""))
    else
        match post_form(endpoint, c, oauthmsg.client_credentials_params(c, scopes))
            Err(f)   => Err(f)
            Ok(body) => oauthmsg.read_token_response(body, arrived_at)

// ── Device code ──────────────────────────────────────────────────────

// Ask for a device code (RFC 8628 § 3.1).
//
// The endpoint is the `device_authorization_endpoint`, which is NOT
// the token endpoint — `oauthdisc.OauthProvider` carries both, and a
// client that sends this to the token endpoint gets
// `unsupported_grant_type`.
//
// ```novo
// use oauthflow
// use oauthmsg
//
// fn main() [io, net, time, async]
//     let c = oauthmsg.client("tv", "")
//     match oauthflow.device_begin("https://id.example/device", c, ["openid"])
//         Ok(g)  => println(oauthmsg.device_prompt(g))
//         Err(_) => println("the request failed")
// ```
pub fn device_begin(endpoint: Str, c: oauthmsg.OauthClient,
                    scopes: [Str]) -> Result<oauthmsg.OauthDeviceGrant, oautherr.OauthFault> [io, net, time, async]
    match post_form(endpoint, c, oauthmsg.device_params(c, scopes))
        Err(f)   => Err(f)
        Ok(body) => oauthmsg.read_device_response(body)

// ONE poll of the token endpoint for a device grant (RFC 8628 § 3.4).
//
// Does not sleep and does not loop, so the caller keeps its own main
// loop — which is what a program with a spinner, a cancel key or other
// work to do needs.  `oautherr.is_pending` is the predicate for "keep
// going": `authorization_pending` and `slow_down` both arrive here as
// an `Err` and neither means the flow failed.
//
// ```novo
// use civil
// use oauthflow
// use oautherr
// use oauthmsg
//
// fn main() [io, net, time, async]
//     match civil.date(2026, 9, 11)
//         Err(_) => println("no")
//         Ok(d)  =>
//             let now = civil.datetime(d, civil.midnight())
//             let c = oauthmsg.client("tv", "")
//             match oauthflow.device_begin("https://id.example/device", c, [])
//                 Err(_) => println("no grant")
//                 Ok(g)  =>
//                     match oauthflow.device_poll("https://id.example/token", c, g, now)
//                         Ok(t)  => println(t.access_token)
//                         Err(f) => println("${oautherr.is_pending(f)}")
// ```
pub fn device_poll(endpoint: Str, c: oauthmsg.OauthClient, g: oauthmsg.OauthDeviceGrant,
                   arrived_at: civil.CivilDateTime) -> Result<oauthtoken.OauthToken, oautherr.OauthFault> [io, net, time, async]
    match post_form(endpoint, c, oauthmsg.device_token_params(c, g.device_code))
        Err(f)   => Err(f)
        Ok(body) => oauthmsg.read_token_response(body, arrived_at)

// Poll until the end user finishes, sleeping between attempts.
//
// The convenience over `device_poll`, and the ONLY function in this
// package that sleeps — which is what the `[time]` in its row is.
// Honours `slow_down` by adding RFC 8628 § 3.5's five seconds, and
// stops at the grant's `expires_in` with `OauthExpiredToken` rather
// than polling a dead code forever.
//
// Takes the main thread for as long as the end user takes, so a
// program that has other work to do should call `device_poll` from its
// own loop instead.
//
// ```novo
// use civil
// use oauthflow
// use oauthmsg
//
// fn main() [io, net, time, async]
//     match civil.date(2026, 9, 11)
//         Err(_) => println("no")
//         Ok(d)  =>
//             let now = civil.datetime(d, civil.midnight())
//             let c = oauthmsg.client("tv", "")
//             match oauthflow.device_begin("https://id.example/device", c, [])
//                 Err(_) => println("no grant")
//                 Ok(g)  =>
//                     match oauthflow.device_wait("https://id.example/token", c, g, now)
//                         Ok(t)  => println(t.access_token)
//                         Err(_) => println("the end user did not finish")
// ```
pub fn device_wait(endpoint: Str, c: oauthmsg.OauthClient, g: oauthmsg.OauthDeviceGrant,
                   started_at: civil.CivilDateTime) -> Result<oauthtoken.OauthToken, oautherr.OauthFault> [io, net, time, async]
    var interval = g.interval
    var waited = 0
    var out: Result<oauthtoken.OauthToken, oautherr.OauthFault> = Err(oautherr.OauthExpiredToken)
    var going = true
    while going
        if waited + interval > g.expires_in
            out = Err(oautherr.OauthExpiredToken)
            going = false
        else
            time.sleep(int.to_float(interval))
            waited = waited + interval
            match device_poll(endpoint, c, g, started_at)
                Ok(t)  =>
                    out = Ok(t)
                    going = false
                Err(f) =>
                    if oautherr.is_pending(f)
                        interval = oautherr.poll_delay(f, interval)
                    else
                        out = Err(f)
                        going = false
    out

// ── Refresh ──────────────────────────────────────────────────────────

// Exchange a refresh token for a new access token (RFC 6749 § 6).
//
// Carries the OLD token's refresh token into the new one where the
// server did not issue a replacement, which is § 6's reading and the
// thing a client that does not do it loses its session over: a server
// that rotates refresh tokens sends a new one and a server that does
// not sends none, and treating "none" as "revoked" logs the end user
// out on the first refresh.
//
// `scopes` narrows the grant; an empty list keeps the original, which
// is what § 6 specifies.  Widening is refused by the server, not here.
//
// ```novo
// use civil
// use oauthflow
// use oauthmsg
// use oauthtoken
//
// fn main() [io, net, time, async]
//     match civil.date(2026, 9, 11)
//         Err(_) => println("no")
//         Ok(d)  =>
//             let now = civil.datetime(d, civil.midnight())
//             let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//             let t = oauthtoken.with_refresh(oauthtoken.token("a"), "r")
//             match oauthflow.refresh("https://id.example/token", c, t, [], now)
//                 Ok(t2) => println(t2.access_token)
//                 Err(_) => println("the refresh failed")
// ```
pub fn refresh(endpoint: Str, c: oauthmsg.OauthClient, t: oauthtoken.OauthToken, scopes: [Str],
               arrived_at: civil.CivilDateTime) -> Result<oauthtoken.OauthToken, oautherr.OauthFault> [io, net, time, async]
    if t.refresh_token == ""
        Err(oautherr.OauthInvalidGrant("the token has no refresh token", ""))
    else
        match post_form(endpoint, c, oauthmsg.refresh_params(c, t.refresh_token, scopes))
            Err(f)   => Err(f)
            Ok(body) =>
                match oauthmsg.read_token_response(body, arrived_at)
                    Err(f)  => Err(f)
                    Ok(new) =>
                        if new.refresh_token == ""
                            Ok(oauthtoken.with_refresh(new, t.refresh_token))
                        else
                            Ok(new)

// The token, refreshed only if it needs it.
//
// What a caller holding a token across a long-running program wants,
// and the reason it is published rather than left to the caller: the
// three-line version everybody writes reads the expiry, refreshes,
// and forgets that a token with NO expiry must not be refreshed on
// every call.
//
// Answers the original token unchanged where it is still good.
//
// ```novo
// use civil
// use oauthflow
// use oauthmsg
// use oauthtoken
//
// fn main() [io, net, time, async]
//     match civil.date(2026, 9, 11)
//         Err(_) => println("no")
//         Ok(d)  =>
//             let now = civil.datetime(d, civil.midnight())
//             let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//             let t = oauthtoken.with_refresh(oauthtoken.token("a"), "r")
//             match oauthflow.ensure_fresh("https://id.example/token", c, t, now, 30)
//                 Ok(t2) => println(t2.access_token)
//                 Err(_) => println("the refresh failed")
// ```
pub fn ensure_fresh(endpoint: Str, c: oauthmsg.OauthClient, t: oauthtoken.OauthToken,
                    now: civil.CivilDateTime,
                    leeway_secs: Int) -> Result<oauthtoken.OauthToken, oautherr.OauthFault> [io, net, time, async]
    if oauthtoken.needs_refresh(t, now, leeway_secs)
        refresh(endpoint, c, t, [], now)
    else
        Ok(t)

// ── Revocation and introspection ─────────────────────────────────────

// Revoke a token (RFC 7009 § 2.1).
//
// Answers `None` on success, which includes the case where the token
// was already invalid — § 2.2 says a server answers 200 for an unknown
// token on purpose, so that revocation is idempotent and so that a
// caller cannot use this endpoint to find out whether a token exists.
//
// The hint is `access_token` or `refresh_token`, or empty; it is a
// hint and a server may ignore it.
//
// ```novo
// use oauthflow
// use oauthmsg
//
// fn main() [io, net, time, async]
//     let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//     match oauthflow.revoke("https://id.example/revoke", c, "tok", "refresh_token")
//         Some(_) => println("the revocation failed")
//         None    => println("revoked")
// ```
pub fn revoke(endpoint: Str, c: oauthmsg.OauthClient, token: Str,
              type_hint: Str) -> ?oautherr.OauthFault [io, net, time, async]
    match post_form(endpoint, c, oauthmsg.revoke_params(c, token, type_hint))
        Err(f) => Some(f)
        Ok(_)  => None

// Introspect a token (RFC 7662 § 2), as the raw JSON document.
//
// Raw rather than a typed value on purpose: introspection is what a
// RESOURCE server calls, the response's members beyond `active` are
// whatever the deployment put there, and a typed struct would be a
// guess about somebody else's schema.  `active` is the one member § 2.2
// makes required, and `is_active` reads it.
//
// This is the one call in the package a resource server makes rather
// than a client, and it is here because it authenticates the same way.
//
// ```novo
// use oauthflow
// use oauthmsg
//
// fn main() [io, net, time, async]
//     let c = oauthmsg.with_secret(oauthmsg.client("rs", ""), "s", oauthmsg.OauthAuthBasic)
//     match oauthflow.introspect("https://id.example/introspect", c, "tok", "")
//         Ok(doc) => println("${oauthflow.is_active(doc)}")
//         Err(_)  => println("the introspection failed")
// ```
pub fn introspect(endpoint: Str, c: oauthmsg.OauthClient, token: Str,
                  type_hint: Str) -> Result<Str, oautherr.OauthFault> [io, net, time, async]
    post_form(endpoint, c, oauthmsg.introspect_params(c, token, type_hint))

// The `active` member of an introspection response.
//
// `false` for a document that does not carry one, which is RFC 7662
// § 2.2's fail-closed reading: a response a resource server cannot
// read is not an authorization.
//
// ```novo
// use oauthflow
//
// fn main() [io]
//     println("${oauthflow.is_active("{}")}")
// ```
pub fn is_active(introspection_json: Str) -> Bool []
    match json.parse(introspection_json)
        None    => false
        Some(v) => json.get_bool(v, "active") ?? false

// Raw bytes from the operating system as an unpadded base64url token, or
// the refusal when the system gave none.  Split from the draw so the
// refusal is a branch a test reaches by passing `None`.
fn armour(raw: ?Bytes) -> Result<Str, oautherr.OauthFault> []
    match raw
        None    => Err(oautherr.OauthNoEntropy)
        Some(b) => Ok(oauthmsg.verifier_of(b))

// `begin` over three draws the caller already made.
//
// Each draw is what `rng.os_bytes` answers: `None` where the system
// gave nothing, which is `OauthNoEntropy`, because a flow refuses
// rather than starting with a value it did not get.  The nonce draw is
// an empty `Some` where no nonce was wanted.  The twin of `begin` for a
// test that must reach the refusal, and for a caller that draws its
// bytes some other way.
//
// ```novo
// use std.bytes
// use oauthflow
// use oauthmsg
//
// fn main() [io]
//     let c = oauthmsg.client("cli", "http://127.0.0.1:8765/cb")
//     match oauthflow.begin_from_draws(c, None, Some(bytes.zeros(0)), None)
//         Ok(_)  => println("started")
//         Err(f) => println(f.message())   // the operating system's generator answered nothing
// ```
pub fn begin_from_draws(c: oauthmsg.OauthClient, state: ?Bytes, nonce: ?Bytes,
                        verifier: ?Bytes) -> Result<oauthmsg.OauthPending, oautherr.OauthFault> []
    match armour(state)
        Err(f) => Err(f)
        Ok(s)  =>
            match armour(nonce)
                Err(f) => Err(f)
                Ok(n)  =>
                    match armour(verifier)
                        Err(f) => Err(f)
                        Ok(v)  => begin_from(c, s, n, v)
